    {
      "id": "edge-dns-over-https-auto",
      "trigger": "Toggling a machine-scope Microsoft Edge policy registered by NewEdge before callback binding; excludes later-added legacy Edge E011/E012.",
      "target": {
        "hive": "HKLM",
        "path": "SOFTWARE\\Policies\\Microsoft\\Edge",
        "name": "DnsOverHttpsMode",
        "type": "String"
      },
      "whenAnyMachineEdgeSettingEnabled": {
        "operation": "write",
        "value": "automatic"
      },
      "otherwise": {
        "operation": "delete"
      },
      "implementationDecision": "Preserve as explicit opt-in setting; do not silently copy this side effect.",
      "aggregateStateScope": "At callback time, evaluate all enabled setting records whose registered target is HKLM\\SOFTWARE\\Policies\\Microsoft\\Edge.",
