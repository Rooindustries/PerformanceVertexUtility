{
  "schemaVersion": 1,
  "productName": "Roo Industries Optimization Suite",
  "profileId": "background-demotion",
  "name": "Background Demotion",
  "profileKind": "process-priority",
  "risk": "low",
  "targetScenario": "Preview and optionally lower priority for known non-critical background helpers while preserving protected workloads.",
  "protectedCatalogPath": "protected-processes.json",
  "foregroundGame": {
    "ruleId": "no-foreground-boost",
    "processNames": [],
    "priorityClass": "Normal",
    "reason": "This profile does not boost a game target.",
    "reasonCodes": [
      "BACKGROUND_DEMOTION_ONLY"
    ]
  },
  "targetGames": [],
  "protectedCompanions": [
    {
      "itemId": "protect-game-launchers",
      "type": "process",
      "names": [
        "Battle.net.exe",
        "steam.exe",
        "EpicGamesLauncher.exe",
        "RiotClientServices.exe",
        "EADesktop.exe",
        "UbisoftConnect.exe",
        "GalaxyClient.exe",
        "gamelaunchhelper.exe"
      ],
      "namePatterns": [
        "*launcher*.exe"
      ],
      "processCategories": [
        "launcher"
      ],
      "reason": "Game launchers are left unchanged so games do not inherit background priority or CPU placement.",
      "reasonCodes": [
        "GAME_LAUNCHER_PROTECTED"
      ],
      "defaultAction": "block"
    }
  ],
  "protectedPreviewProcessNames": [
    "Tailscale.exe",
    "Wispr Flow.exe",
    "MsMpEng.exe",
    "audiodg.exe",
    "msedgewebview2.exe"
  ],
  "safeCandidates": [
    {
      "ruleId": "sync-clients-manual-review",
      "match": {
        "processNames": [
          "OneDrive.exe",
          "GoogleDriveFS.exe",
          "Dropbox.exe"
        ]
      },
      "reason": "Sync clients remain manual-review candidates until a user approves them.",
      "reasonCodes": [
        "SYNC_CLIENT_MANUAL_REVIEW"
      ],
      "risk": "low"
    }
  ],
  "rules": [
    {
      "ruleId": "demote-browser-renderers",
      "enabled": true,
      "match": {
        "processNames": [
          "chrome.exe",
          "msedge.exe",
          "firefox.exe",
          "brave.exe",
          "steamwebhelper.exe",
          "EpicWebHelper.exe"
        ],
        "namePatterns": [
          "*webhelper*.exe",
          "*cef*.exe"
        ],
        "processCategories": [
          "browserWebView"
        ],
        "excludeProcessNames": [
          "msedgewebview2.exe"
        ]
      },
      "action": {
        "actionType": "setPriority",
        "priorityClass": "BelowNormal",
        "reason": "Background browser helpers are safe priority-demotion candidates."
      },
      "risk": "low",
      "rollback": {
        "restorePriorityClass": true
      }
    },
    {
      "ruleId": "demote-updaters",
      "enabled": true,
      "match": {
        "processNames": [],
        "namePatterns": [
          "*updater*.exe",
          "*update*.exe"
        ],
        "excludeProcessNames": [
          "MicrosoftEdgeUpdate.exe",
          "MoUsoCoreWorker.exe",
          "UsoClient.exe",
          "TiWorker.exe",
          "TrustedInstaller.exe"
        ]
      },
      "action": {
        "actionType": "setPriority",
        "priorityClass": "BelowNormal",
        "reason": "Updaters should use lower priority while a game workload is active. Game launchers are left unchanged."
      },
      "risk": "low",
      "rollback": {
        "restorePriorityClass": true
      }
    }
  ],
  "telemetryTargets": [
    "process-count",
    "working-set",
    "private-bytes",
    "commit-pressure"
  ],
  "rollbackPolicy": {
    "supported": true,
    "scope": "process-priority",
    "stateRoot": "backend\\state",
    "restoreOriginalPriorityClass": true
  },
  "safety": {
    "confirmedApplyChanges": [
      "PriorityClass"
    ],
    "previewOnlyChanges": [
      "Affinity",
      "IoPriority",
      "PowerThrottling"
    ],
    "continuousEnforcement": false,
    "runtimeService": false
  }
}
