{
  "schemaVersion": 1,
  "productName": "Roo Industries Optimization Suite",
  "policyId": "uninstall-cleanup-preview",
  "name": "Uninstall And Cleanup Preview Policy",
  "previewOnly": true,
  "confirmedExecutionEnabled": false,
  "blockProtectedAppsByDefault": true,
  "allowProtectedOverrideInPreview": false,
  "officialUninstall": {
    "previewOnly": true,
    "executeInPreview": false,
    "preferOfficialUninstallString": true,
    "showQuietCommandWhenPresent": true,
    "requireExplicitConfirmationBeforeFutureExecution": true,
    "restorePointRequiredBeforeFutureExecution": true,
    "blockedCommandFamilies": [
      "winget uninstall",
      "msiexec uninstall",
      "remove-appxpackage",
      "third-party uninstaller automation",
      "driver cleanup tools"
    ]
  },
  "queue": {
    "officialUninstallFirst": true,
    "leftoverScanAfterOfficialUninstall": true,
    "requiresElevation": true,
    "confirmationRequired": true,
    "protectedAppsBlocked": true,
    "maxBatchSize": 25
  },
  "leftoverScan": {
    "previewOnly": true,
    "allowFuzzySharedPathDeletion": false,
    "metadataSignals": [
      "installLocation",
      "publisher",
      "productGuid",
      "packageId",
      "knownAppDataPath",
      "serviceReference",
      "scheduledTaskReference",
      "startupReference"
    ],
    "defaultSelectedTypes": [
      "folder",
      "file"
    ],
    "defaultSelectedConfidence": [
      "high"
    ]
  },
  "cleanupDeletion": {
    "previewOnly": true,
    "allowDeletionInPreview": false,
    "requireFileBackup": true,
    "requireRegistryExport": true,
    "requireServiceStateBackup": true,
    "requireScheduledTaskExport": true,
    "requireStartupEntryExport": true,
    "rollbackActionId": "apps.rollbackCleanup",
    "backupRoot": "C:\\ProgramData\\RooOptimizationSuite\\backups\\cleanup"
  },
  "executionDesign": {
    "previewOnly": true,
    "executorImplemented": false,
    "planActionId": "apps.planUninstallCleanupExecution",
    "requireOfficialUninstallPreview": true,
    "requireCleanupManifest": true,
    "requirePostUninstallLeftoverRescan": true,
    "requireExplicitUserConfirmation": true,
    "requireRestorePointBeforeApply": true,
    "requireBackupsBeforeApply": true,
    "allowProtectedItemApply": false,
    "dryRunWritesState": false,
    "phases": [
      "preflight-review",
      "official-uninstall",
      "post-uninstall-leftover-rescan",
      "backup-and-export",
      "cleanup-apply",
      "verify-and-rollback-ready"
    ]
  },
  "state": {
    "repoStateRoot": "backend\\state",
    "dryRunWritesState": false
  }
}
