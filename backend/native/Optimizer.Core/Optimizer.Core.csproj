<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DefineConstants Condition="'$(RooIndustriesRelease)' == 'true'">$(DefineConstants);ROO_RELEASE</DefineConstants>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants Condition="'$(GovernorTestHooks)' == 'true'">$(DefineConstants);GOVERNOR_TEST_HOOKS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RooTestHooks)' == 'true'">
    <DefineConstants>$(DefineConstants);ROO_TEST_HOOKS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OptimizerCore" />
    <EmbeddedResource Include="WindowsControls.ps1" />
    <EmbeddedResource Include="../../catalogs/adobe-hosts.txt" LogicalName="Optimizer.Core.AdobeHosts.txt" />
    <Compile Include="../CpuSets/RooIndustriesCpuSets.cs" Link="Interop/CpuSets.cs" />
  </ItemGroup>
</Project>
