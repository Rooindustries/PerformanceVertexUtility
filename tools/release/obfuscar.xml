<?xml version="1.0" encoding="utf-8"?>
<Obfuscator>
  <Var name="InPath" value="{InPath}" />
  <Var name="OutPath" value="{OutPath}" />
  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameEvents" value="false" />
  <Var name="RenameFields" value="true" />
  <Var name="HideStrings" value="false" />
  <Var name="OptimizeMethods" value="false" />
  <Var name="SkipGenerated" value="true" />
  <Var name="XmlMapping" value="true" />
  <Var name="LogFile" value="$(OutPath)\obfuscar-map.xml" />
  <AssemblySearchPath path="$(InPath)" />
{Modules}
</Obfuscator>
