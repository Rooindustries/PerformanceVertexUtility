    { "pattern": "Drivers & GPU", "why": "the old page title" },
    { "pattern": "Network & devices", "why": "the old panel name" },
    { "pattern": "No driver recommendations", "why": "the old empty download card" },
    { "pattern": "Close and reopen", "why": "the old error advice" },
