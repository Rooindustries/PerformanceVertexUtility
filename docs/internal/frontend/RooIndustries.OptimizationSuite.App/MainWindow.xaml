<Window
    x:Class="RooIndustries.OptimizationSuite.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="{StaticResource RooIndustriesCanvasDeepBrush}">
        <Rectangle x:Name="RadialOverlay" Fill="{StaticResource RooIndustriesAppRadialBrush}" IsHitTestVisible="False" />

        <NavigationView
            x:Name="Nav"
            FontFamily="{StaticResource RooIndustriesFontFamily}"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            ExpandedModeThresholdWidth="1100" CompactModeThresholdWidth="720"
            OpenPaneLength="224"
            SelectionChanged="Nav_SelectionChanged">

            <NavigationView.Resources>
                <StaticResource x:Key="FocusVisualPrimaryBrush" ResourceKey="RooIndustriesFocusVisualBrush" />
                <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="Transparent" />
                <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="RooIndustriesFocusVisualBrush" />
                <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent" />
                <StaticResource x:Key="NavigationViewItemForegroundFocus" ResourceKey="RooIndustriesTextPrimaryBrush" />
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <Grid Padding="4,12,4,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="LogoImage" Grid.Column="0" Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="ROO INDUSTRIES" FontFamily="{StaticResource RooIndustriesFontFamily}"
                                   FontSize="13" FontWeight="SemiBold" CharacterSpacing="80"
                                   Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                        <TextBlock Text="Optimization Suite" FontFamily="{StaticResource RooIndustriesFontFamily}"
                                   FontSize="11" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="YOUR PC" />
                <NavigationViewItem Content="Overview" Tag="dashboard" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/home.svg" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Games &amp; processes" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/game.svg" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Installed apps" Tag="uninstall">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/apps.svg" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="SYSTEM" />
                <NavigationViewItem Content="Startup &amp; services" Tag="startup">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/startup.svg" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Drivers &amp; GPU" Tag="drivers">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/gpu.svg" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Memory" Tag="memory">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/memory.svg" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Windows settings" Tag="windows">
                    <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/windows.svg" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Timer &amp; cache" Tag="monitoring">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/timer.svg" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="UTILITIES" />
                <NavigationViewItem Content="Tools" Tag="tools">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/tools.svg" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Backups &amp; history" Tag="restore">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/history.svg" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Top" Fill="{StaticResource RooIndustriesTopHairlineBrush}" />
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
