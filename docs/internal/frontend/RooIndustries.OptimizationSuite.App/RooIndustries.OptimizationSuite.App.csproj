<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <StartupHookSupport>false</StartupHookSupport>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RooIndustries.OptimizationSuite</RootNamespace>
    <AssemblyName>RooIndustries.OptimizationSuite.App</AssemblyName>
    <Title>Performance Vertex Utility</Title>
    <Product>Performance Vertex Utility</Product>
    <Company>Performance Vertex Utility</Company>
    <Version>0.11.1-beta</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RooIndustriesTestHooks)' == 'true'">
    <DefineConstants>$(DefineConstants);ROO_INDUSTRIES_TEST_HOOKS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Tweaks\presentation.json" LogicalName="RooIndustries.TweakPresentation.json" />
    <EmbeddedResource Include="Assets\Tweaks\icons.json" LogicalName="RooIndustries.TweakIcons.json" />
    <EmbeddedResource Include="Assets\Guides\memory-guides.json" LogicalName="RooIndustries.MemoryGuides.json" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <ProjectReference Include="..\..\..\..\backend\native\Optimizer.Core\Optimizer.Core.csproj" />
    <Content Include="Assets\**\*.*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets')" />
  </ItemGroup>

  <Target Name="EmbedBugReportWebhook" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <BugReportWebhookFile>$(IntermediateOutputPath)bug-report-webhook.txt</BugReportWebhookFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(BugReportWebhookFile)" Lines="$([MSBuild]::Escape('url=$(ROO_INDUSTRIES_BUG_WEBHOOK)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(BugReportWebhookFile)" LogicalName="RooIndustries.BugReportWebhook" />
    </ItemGroup>
  </Target>

  <Target Name="EmbedUpdateFeed" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <UpdateFeedFile>$(IntermediateOutputPath)update-feed.txt</UpdateFeedFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(UpdateFeedFile)" Lines="$([MSBuild]::Escape('url=$(ROO_INDUSTRIES_UPDATE_FEED)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(UpdateFeedFile)" LogicalName="RooIndustries.UpdateFeed" />
    </ItemGroup>
  </Target>

</Project>
