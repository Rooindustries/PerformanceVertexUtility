<UserControl
    x:Class="RooIndustries.OptimizationSuite.Views.CpuSetsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RooIndustries.OptimizationSuite.ViewModels">
    <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource RooIndustriesSurfaceCardBrush}" BorderBrush="{StaticResource RooIndustriesBorderBrush}">
        <StackPanel Spacing="12">
            <TextBlock Text="CPU selection" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
            <TextBlock Text="Set preferred CPUs for one application without forcing a hard affinity mask." TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{x:Bind ViewModel.Processes}" SelectedItem="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}" PlaceholderText="Choose an application"
                          IsEnabled="{x:Bind ViewModel.CanChooseProcess, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CpuProcessPicker" AutomationProperties.Name="Application for CPU selection" />
                <Button Grid.Column="1" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.CanChooseProcess, Mode=OneWay}" AutomationProperties.AutomationId="CpuRefresh" />
            </Grid>
            <CheckBox Content="Use Windows default" IsChecked="{x:Bind ViewModel.UseWindowsDefault, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChooseProcess, Mode=OneWay}" AutomationProperties.AutomationId="CpuUseDefault" />
            <GridView ItemsSource="{x:Bind ViewModel.Cpus}" SelectionMode="None" IsItemClickEnabled="False" IsEnabled="{x:Bind ViewModel.CanChooseCpus, Mode=OneWay}" MaxHeight="180"
                      ScrollViewer.VerticalScrollBarVisibility="Visible" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CpuChoices">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CpuChoice">
                        <CheckBox IsChecked="{x:Bind Selected, Mode=TwoWay}" IsEnabled="{x:Bind Cpu.Available}" AutomationProperties.Name="{x:Bind Cpu.Label}" Width="190" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Cpu.Label}" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Cpu.Detail}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="CpuStatus" />
            <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.ReviewSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" Visibility="{x:Bind ViewModel.HasReview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="CpuReview" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Preview" Command="{x:Bind ViewModel.PreviewCommand}" IsEnabled="{x:Bind ViewModel.CanPreview, Mode=OneWay}" AutomationProperties.AutomationId="CpuPreview" />
                <Button Content="Apply selection" Command="{x:Bind ViewModel.ApplyCommand}" IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}" AutomationProperties.AutomationId="CpuApply" Background="{StaticResource RooIndustriesNavCtaBrush}" Foreground="{StaticResource RooIndustriesOnCtaBrush}" />
                <Button Content="{x:Bind ViewModel.RestoreLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RestoreCommand}" IsEnabled="{x:Bind ViewModel.CanRestore, Mode=OneWay}" AutomationProperties.AutomationId="CpuRestore" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
