<UserControl
    x:Class="RooIndustries.OptimizationSuite.Views.GameSessionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RooIndustries.OptimizationSuite.ViewModels">
    <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource RooIndustriesSurfaceCardBrush}" BorderBrush="{StaticResource RooIndustriesBorderBrush}">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Game sessions" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                <Button Grid.Column="1" Content="New session" Command="{x:Bind ViewModel.NewSessionCommand}" IsEnabled="{x:Bind ViewModel.CanChooseSession, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionNew" />
                <Button Grid.Column="2" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.CanChooseSession, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionRefresh" />
            </Grid>
            <ComboBox ItemsSource="{x:Bind ViewModel.Sessions}" SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}" PlaceholderText="Saved game sessions" HorizontalAlignment="Stretch"
                      IsEnabled="{x:Bind ViewModel.CanChooseSession, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionHistory" />
            <ContentControl IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="10">
                <TextBlock Text="Close the game. Choose its running launcher and the game's executable, then review the settings." TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                <ComboBox Header="Launcher" ItemsSource="{x:Bind ViewModel.Launchers}" SelectedItem="{x:Bind ViewModel.SelectedLauncher, Mode=TwoWay}" PlaceholderText="For example, Epic Games Launcher" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="GameSessionLauncher" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Header="Game executable" Text="{x:Bind ViewModel.GamePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Select the game's .exe file" AutomationProperties.AutomationId="GameSessionExecutable" />
                    <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom" Click="Browse_Click" AutomationProperties.AutomationId="GameSessionBrowse" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Settings}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapGrid Orientation="Horizontal" ItemWidth="250" ItemHeight="78" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameSessionSetting">
                            <ComboBox Header="{x:Bind Label}" ItemsSource="{x:Bind Options}" SelectedItem="{x:Bind Selected, Mode=TwoWay}" Margin="0,0,12,10" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox IsChecked="{x:Bind ViewModel.AcceptLauncherScope, Mode=TwoWay}" AutomationProperties.AutomationId="GameSessionScope">
                    <TextBlock Text="I accept that launcher core limits and I/O/memory defaults also affect its other new child processes." TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>
            </ContentControl>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox Header="Cores" ItemsSource="{x:Bind ViewModel.CoreChoices}" SelectedItem="{x:Bind ViewModel.SelectedCores, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanChooseCores, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionCores" />
                <TextBox Grid.Column="1" Header="CPU mask" Text="{x:Bind ViewModel.AffinityMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.CanChooseCores, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionMask" />
                <Button Grid.Column="2" Content="Switch cores" Command="{x:Bind ViewModel.SwitchCoresCommand}" VerticalAlignment="Bottom" IsEnabled="{x:Bind ViewModel.CanSwitch, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionSwitchCores" />
            </Grid>
            <Border Padding="12" CornerRadius="8" Background="{StaticResource RooIndustriesSurfaceInputBrush}" Visibility="{x:Bind ViewModel.HasReview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Bind ViewModel.ReviewSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" AutomationProperties.AutomationId="GameSessionReview" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Review settings" Command="{x:Bind ViewModel.PreviewCommand}" IsEnabled="{x:Bind ViewModel.CanPreview, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionPreview" />
                <Button Content="Arm session" Command="{x:Bind ViewModel.StartCommand}" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" Background="{StaticResource RooIndustriesNavCtaBrush}" Foreground="{StaticResource RooIndustriesOnCtaBrush}" AutomationProperties.AutomationId="GameSessionStart" />
                <Button Content="Stop and restore" Command="{x:Bind ViewModel.StopCommand}" IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionStop" />
                <Button Content="Recover" Command="{x:Bind ViewModel.RecoverCommand}" IsEnabled="{x:Bind ViewModel.CanRecover, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionRecover" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" AutomationProperties.AutomationId="GameSessionStatus" />
            <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" Visibility="{x:Bind ViewModel.Detail, Mode=OneWay, Converter={StaticResource StringToVisibility}}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" AutomationProperties.AutomationId="GameSessionDetail" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Fields}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameSessionField">
                        <Grid Padding="0,5" ColumnSpacing="12" RowSpacing="3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Requested" FontSize="11" Foreground="{StaticResource RooIndustriesTextMutedBrush}"/><TextBlock Text="{x:Bind Requested}" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Observed" FontSize="11" Foreground="{StaticResource RooIndustriesTextMutedBrush}"/><TextBlock Text="{x:Bind Observed}" TextWrapping="Wrap"/></StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Bind Result}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="An armed session continues after this window closes and follows game relaunches. Stop it here when finished. GPU priority is applied only when the game's actual class can be read and changed." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
        </StackPanel>
    </Border>
</UserControl>
