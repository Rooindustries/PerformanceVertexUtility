<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="using:RooIndustries.OptimizationSuite.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RooIndustries.OptimizationSuite.Views.GameSessionPanel" xmlns:vm="using:RooIndustries.OptimizationSuite.ViewModels">
    <StackPanel Spacing="16">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{x:Bind ViewModel.Sessions}" SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}" PlaceholderText="Previous sessions" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanChooseSession, Mode=OneWay}" AutomationProperties.Name="Previous game sessions" AutomationProperties.AutomationId="GameSessionHistory" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="New" Command="{x:Bind ViewModel.NewSessionCommand}" IsEnabled="{x:Bind ViewModel.CanChooseSession, Mode=OneWay}" AutomationProperties.Name="New game session" AutomationProperties.AutomationId="GameSessionNew" />
                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.CanChooseSession, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionRefresh" />
            </StackPanel>
        </Grid>
        <Border Style="{StaticResource PanelBorderStyle}">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="1. Choose a game" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <TextBlock Text="Keep the launcher open and close the game before setting it up." TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                </StackPanel>
                <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                    <views:AdaptivePanel MinColumnWidth="320" MaxColumns="2">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Game .exe file" Text="{x:Bind ViewModel.GamePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Browse to the game's executable" AutomationProperties.AutomationId="GameSessionExecutable" />
                            <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom" Click="Browse_Click" AutomationProperties.AutomationId="GameSessionBrowse" />
                        </Grid>
                        <ComboBox Header="Launcher" ItemsSource="{x:Bind ViewModel.Launchers}" SelectedItem="{x:Bind ViewModel.SelectedLauncher, Mode=TwoWay}" PlaceholderText="Choose a running launcher" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="GameSessionLauncher" />
                    </views:AdaptivePanel>
                </ContentControl>
            </StackPanel>
        </Border>
        <views:AdaptivePanel MinColumnWidth="520" MaxColumns="2" Visibility="{x:Bind ViewModel.HasLauncher, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="2. Set priorities and CPU cores" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <TextBlock Text="Leave a setting on Keep current to preserve its value." TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Settings}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:AdaptivePanel MinColumnWidth="210" MaxColumns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameSessionSetting">
                                <ComboBox Header="{x:Bind Label}" ItemsSource="{x:Bind Options}" SelectedItem="{x:Bind Selected, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Header="CPU cores" ItemsSource="{x:Bind ViewModel.CoreChoices}" SelectedItem="{x:Bind ViewModel.SelectedCores, Mode=TwoWay}" PlaceholderText="Choose a launcher first" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanChooseCores, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionCores" />
                        <Button Grid.Column="1" Content="Change cores" Command="{x:Bind ViewModel.SwitchCoresCommand}" VerticalAlignment="Bottom" Visibility="{x:Bind ViewModel.HasSession, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" IsEnabled="{x:Bind ViewModel.CanSwitch, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionSwitchCores" />
                    </Grid>
                    <Expander Header="Custom CPU mask" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="GameSessionAdvanced">
                        <StackPanel Spacing="8">
                            <TextBlock Text="For a custom core selection, enter a hexadecimal affinity mask." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                            <TextBox Header="CPU mask" Text="{x:Bind ViewModel.AffinityMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.CanChooseCores, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionMask" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="3. Review and start" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <CheckBox IsChecked="{x:Bind ViewModel.AcceptLauncherScope, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionScope">
                        <TextBlock Text="I understand that core limits and I/O or memory defaults also affect other apps started by this launcher." TextWrapping="Wrap" />
                    </CheckBox>
                    <Border Padding="12" CornerRadius="6" Background="{StaticResource RooIndustriesSurfaceInputBrush}" Visibility="{x:Bind ViewModel.HasReview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Bind ViewModel.ReviewSummary, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="GameSessionReview" />
                    </Border>
                    <views:AdaptivePanel MinColumnWidth="180" MaxColumns="4" Compact="True">
                        <Button Content="Review changes" Command="{x:Bind ViewModel.PreviewCommand}" IsEnabled="{x:Bind ViewModel.CanPreview, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionPreview" />
                        <Button Content="Start" Command="{x:Bind ViewModel.StartCommand}" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" Background="{StaticResource RooIndustriesNavCtaBrush}" Foreground="{StaticResource RooIndustriesOnCtaBrush}" AutomationProperties.AutomationId="GameSessionStart" />
                        <Button Content="Stop and restore" Command="{x:Bind ViewModel.StopCommand}" Visibility="{x:Bind ViewModel.HasSession, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionStop" />
                        <Button Content="Recover settings" Command="{x:Bind ViewModel.RecoverCommand}" Visibility="{x:Bind ViewModel.CanRecover, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" IsEnabled="{x:Bind ViewModel.CanRecover, Mode=OneWay}" AutomationProperties.AutomationId="GameSessionRecover" />
                    </views:AdaptivePanel>
                    <TextBlock Text="When ready, launch the game normally. These settings stay active until you select Stop and restore, even if you close this app." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                </StackPanel>
            </Border>
        </views:AdaptivePanel>
        <StackPanel Spacing="6">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.AutomationId="GameSessionStatus" />
            <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" Visibility="{x:Bind ViewModel.Detail, Mode=OneWay, Converter={StaticResource StringToVisibility}}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" AutomationProperties.AutomationId="GameSessionDetail" />
        </StackPanel>
        <Border Style="{StaticResource PanelBorderStyle}" Visibility="{x:Bind ViewModel.Fields.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
            <StackPanel Spacing="12">
                <TextBlock Text="Applied settings" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <TextBlock Text="Compare your selection with the value read from the game." TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameSessionField">
                            <Grid Padding="0,8" ColumnSpacing="12" RowSpacing="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RooIndustriesBorderBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Selected" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                    <TextBlock Text="{x:Bind Requested}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Current" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                    <TextBlock Text="{x:Bind Observed}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Bind Result}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
