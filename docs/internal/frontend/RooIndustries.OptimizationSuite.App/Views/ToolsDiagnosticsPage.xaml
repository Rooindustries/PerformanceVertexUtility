<Page x:Class="RooIndustries.OptimizationSuite.Views.ToolsDiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:RooIndustries.OptimizationSuite.ViewModels">
    <Grid Padding="{StaticResource RooIndustriesPageMargin}" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Tools" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Open a tool, or install it if it is not on this PC yet." Foreground="{StaticResource RooIndustriesTextMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE950;" FontSize="26" Foreground="{StaticResource RooIndustriesAccentBrush}"/>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="BIOS settings" FontWeight="SemiBold"/>
                    <TextBlock Text="Load settings → make changes → review → apply → restart" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Open BIOS settings" Click="OpenFirmware" AutomationProperties.AutomationId="OpenFirmware"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox PlaceholderText="Search tools" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ToolSearch"/>
            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.Category, Mode=TwoWay}" Width="155" AutomationProperties.Name="Tool category" AutomationProperties.AutomationId="ToolCategory"/>
            <Button Grid.Column="2" Content="Refresh" Click="Refresh" AutomationProperties.AutomationId="RefreshTools"/>
        </Grid>
        <Grid Grid.Row="3">
            <GridView x:Name="ToolGrid" ItemsSource="{x:Bind ViewModel.ToolRows}" SelectionMode="None" IsItemClickEnabled="False"
                      SizeChanged="ResizeTools" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0,0,0,8"
                      ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,10"/></Style></GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolRow">
                        <Border Style="{StaticResource PanelBorderStyle}" Padding="12,10" MinHeight="76">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE713;" Visibility="{x:Bind HasIcon, Converter={StaticResource InverseBoolToVisibility}}" FontSize="28"/>
                                <Border Background="#FFF6F6F6" CornerRadius="5" Width="36" Height="36" Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibility}}"><Image Source="{x:Bind Icon}" Width="28" Height="28" AutomationProperties.AccessibilityView="Raw"/></Border>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Description}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="{x:Bind Action}" Tag="{x:Bind}" Click="OpenTool" MinWidth="52" Padding="8,3" AutomationProperties.Name="{x:Bind AccessibleAction}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" Width="32" Height="32"/>
        </Grid>
        <StackPanel Grid.Row="4" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Count, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}"/>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="ToolStatus"/>
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
