<Page
    x:Class="RooIndustries.OptimizationSuite.Views.RestoreLogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RooIndustries.OptimizationSuite.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="{StaticResource RooIndustriesPageMargin}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Reading restore state" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
        </StackPanel>

        <ScrollViewer Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" HorizontalAlignment="Stretch" Padding="0,0,6,0">

                <Border Style="{StaticResource CommandHeaderBorderStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="ms-appx:///Assets/Icons/history.svg" Style="{StaticResource PageHeaderIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="7">
                            <TextBlock Text="Backups &amp; history" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{x:Bind ViewModel.RestoreState, Mode=OneWay, Converter={StaticResource RiskToBrush}}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RestoreHeadline, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                            </Grid>
                            <TextBlock Text="Check saved process settings and session history."
                                       FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FocalPanelBorderStyle}">
                    <StackPanel Spacing="10">
                        <Button Content="Open game settings" Click="OpenProcessControl" HorizontalAlignment="Left"/>
                        <TextBlock Text="Saved settings" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesAccentBrush}" />
                        <ListView SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" Padding="0"
                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                                  ItemsSource="{x:Bind ViewModel.RestoreRows}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatusLine">
                                    <Grid ColumnSpacing="14" Padding="0,8" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="Open Games &amp; processes to stop a session or restore process settings."
                                   FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Padding="0">
                    <StackPanel>
                        <Grid ColumnSpacing="12" Padding="18,16,18,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Time" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="Action" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="App" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="Change" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                            <TextBlock Grid.Column="4" Text="Restore" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource RooIndustriesBorderBrush}" />
                        <ListView SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" Padding="0"
                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                                  ItemsSource="{x:Bind ViewModel.HistoryRows}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:AuditRow">
                                    <Grid ColumnSpacing="12" Padding="18,11" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Time}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Action}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                                                   Foreground="{x:Bind ActionState, Converter={StaticResource RiskToBrush}}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Target}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Change}" FontSize="12" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind RestoreText}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                                                   Foreground="{x:Bind RestoreState, Converter={StaticResource RiskToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
