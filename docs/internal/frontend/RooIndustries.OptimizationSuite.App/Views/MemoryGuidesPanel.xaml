<UserControl
    x:Class="RooIndustries.OptimizationSuite.Views.MemoryGuidesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RooIndustries.OptimizationSuite.Models">
    <Border Style="{StaticResource PanelBorderStyle}">
        <StackPanel Spacing="10">
            <TextBlock Text="{x:Bind Guides.Title}" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
            <TextBlock Text="{x:Bind Guides.Intro}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
            <ItemsControl ItemsSource="{x:Bind Guides.Guides}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MemoryGuide">
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" AutomationProperties.Name="{x:Bind Title}">
                            <Expander.Header>
                                <StackPanel Spacing="2" Padding="0,6">
                                    <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Summary}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="8">
                                <ItemsControl ItemsSource="{x:Bind NumberedSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" FontSize="13" LineHeight="19" Margin="0,0,0,6" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Bind NoteText}" FontSize="12" LineHeight="17" TextWrapping="Wrap" FontStyle="Italic" Foreground="{StaticResource RooIndustriesTextMutedBrush}" Visibility="{x:Bind NoteText, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
