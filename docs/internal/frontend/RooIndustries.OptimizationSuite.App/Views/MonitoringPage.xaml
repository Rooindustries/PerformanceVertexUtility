<Page
    x:Class="RooIndustries.OptimizationSuite.Views.MonitoringPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RooIndustries.OptimizationSuite.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <DataTemplate x:Key="LiveTileTemplate" x:DataType="vm:MetricTile">
            <StackPanel Spacing="6" Padding="0,0,18,0">
                <TextBlock Text="{x:Bind Value}" FontSize="22" FontWeight="SemiBold" LineHeight="26" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                <TextBlock Text="{x:Bind Label}" FontSize="13" LineHeight="19" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                <TextBlock Text="{x:Bind Caption}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PendingTileTemplate" x:DataType="vm:MetricTile">
            <StackPanel Spacing="6" Padding="0,0,18,0">
                <TextBlock Text="{x:Bind Value}" FontSize="16" FontWeight="SemiBold" LineHeight="22" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                <TextBlock Text="{x:Bind Label}" FontSize="13" LineHeight="19" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                <TextBlock Text="{x:Bind Caption}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SensorTemplate" x:DataType="vm:StatusLine">
            <Grid Padding="0,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                    <TextBlock Text="{x:Bind Value}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource RooIndustriesPageMargin}">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Reading this PC" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
        </StackPanel>

        <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{StaticResource PanelBorderStyle}" Translation="0,0,16"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
            <StackPanel Spacing="8">
                <TextBlock Text="Can't read this PC yet" Style="{StaticResource SectionHeaderTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="MonitoringScroller" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MonitoringContent" Spacing="18" HorizontalAlignment="Center" MaxWidth="1320">

                <Border Style="{StaticResource CommandHeaderBorderStyle}" Translation="0,0,32">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooIndustriesAccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Text="Live Feel" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="STUTTER FIXES" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="{x:Bind ViewModel.StutterActionTitle, Mode=OneWay}" FontSize="15" LineHeight="21"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.StutterActionDetail, Mode=OneWay}" FontSize="12" LineHeight="17"
                                           TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                            </StackPanel>
                            <ProgressRing Grid.Column="1" Width="20" Height="20" IsActive="{x:Bind ViewModel.StutterBusy, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="4">
                            <CheckBox Content="Approve short timer run"
                                      IsChecked="{x:Bind ViewModel.LatencySessionApproved, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanRunStutterAction, Mode=OneWay}"
                                      Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                            <CheckBox Content="Approve shader-cache cleanup"
                                      IsChecked="{x:Bind ViewModel.ShaderCacheApproved, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanRunStutterAction, Mode=OneWay}"
                                      Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.StutterGateSummary, Mode=OneWay}" FontSize="12" LineHeight="17"
                                       TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ShaderRestoreHint, Mode=OneWay}" FontSize="12" LineHeight="17"
                                       TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Check" Command="{x:Bind ViewModel.CheckStutterPlanCommand}"
                                    AutomationProperties.Name="Check stutter fixes"
                                    IsEnabled="{x:Bind ViewModel.CanRunStutterAction, Mode=OneWay}" Padding="12,7" />
                            <Button Grid.Column="1" Content="Run timer" Command="{x:Bind ViewModel.RunTimerSessionCommand}"
                                    AutomationProperties.Name="Run timer session"
                                    IsEnabled="{x:Bind ViewModel.CanRunTimerSession, Mode=OneWay}"
                                    Background="{StaticResource RooIndustriesNavCtaBrush}" Foreground="{StaticResource RooIndustriesOnCtaBrush}" Padding="12,7" />
                            <Button Grid.Column="2" Content="Check cache" Command="{x:Bind ViewModel.PrepareShaderCacheCommand}"
                                    AutomationProperties.Name="Check shader cache cleanup"
                                    IsEnabled="{x:Bind ViewModel.CanPrepareShaderCache, Mode=OneWay}" Padding="12,7" />
                            <Button Grid.Column="3" Content="Restore" Command="{x:Bind ViewModel.RestoreShaderCacheCommand}"
                                    AutomationProperties.Name="Restore shader cache"
                                    IsEnabled="{x:Bind ViewModel.CanRestoreShaderCache, Mode=OneWay}" Padding="12,7" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="RIGHT NOW" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.LiveTiles}" ItemTemplate="{StaticResource LiveTileTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="160" MinColumnSpacing="8" MinRowSpacing="16" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="FRAME FEEL" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.PendingTiles}" ItemTemplate="{StaticResource PendingTileTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="160" MinColumnSpacing="8" MinRowSpacing="16" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <TextBlock Text="Connect PresentMon or HWiNFO64 during a session to measure FPS, 1% lows, and frametimes."
                                   FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="SENSORS" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sensors}" ItemTemplate="{StaticResource SensorTemplate}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
