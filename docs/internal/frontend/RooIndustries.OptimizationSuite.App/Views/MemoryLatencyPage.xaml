<Page
    x:Class="RooIndustries.OptimizationSuite.Views.MemoryLatencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RooIndustries.OptimizationSuite.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="{StaticResource RooIndustriesPageMargin}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Reading memory and latency" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
        </StackPanel>

        <ScrollViewer Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Stretch" Padding="0,0,6,0">

                <Border Style="{StaticResource CommandHeaderBorderStyle}" Translation="0,0,32">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooIndustriesAccentBrush}" />
                        <StackPanel Grid.Column="1" Spacing="7">
                            <TextBlock Text="Memory &amp; Latency" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{x:Bind ViewModel.PressureState, Mode=OneWay, Converter={StaticResource RiskToBrush}}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MemoryHeadline, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                            </Grid>
                            <TextBlock Text="RAM pressure right now, plus the diagnostics that find real stutter sources."
                                       FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FocalPanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="MEMORY PRESSURE" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.MemoryUsedPercent, Mode=OneWay}"
                                     Height="8" CornerRadius="4"
                                     Foreground="{x:Bind ViewModel.PressureState, Mode=OneWay, Converter={StaticResource RiskToBrush}}"
                                     Background="{StaticResource RooIndustriesSurfaceInputBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.MemoryDetail, Mode=OneWay}" FontSize="13" LineHeight="19"
                                   TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="TOP MEMORY USERS" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        <ListView SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" Padding="0"
                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                                  ItemsSource="{x:Bind ViewModel.TopMemoryRows}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:BackgroundRow">
                                    <Grid ColumnSpacing="14" Padding="0,9" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Role}" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Ram}" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{StaticResource RooIndustriesTextDisplayBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind StateText}" FontSize="12" FontWeight="Medium"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="LATENCY &amp; CACHES" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        <ListView SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" Padding="0"
                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                                  ItemsSource="{x:Bind ViewModel.DiagnosticRows}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiagnosticRow">
                                    <Grid ColumnSpacing="14" Padding="0,9" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Detail}" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                                       Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind StateText}" FontSize="12" FontWeight="Medium"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="SENSORS" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        <ListView SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" Padding="0"
                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                                  ItemsSource="{x:Bind ViewModel.SensorRows}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatusLine">
                                    <Grid ColumnSpacing="14" Padding="0,7" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="13"
                                                   Foreground="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
