<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:views="using:RooIndustries.OptimizationSuite.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RooIndustries.OptimizationSuite.Views.MemoryLatencyPage" mc:Ignorable="d" xmlns:vm="using:RooIndustries.OptimizationSuite.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
    <Grid Padding="{StaticResource RooIndustriesPageMargin}">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Spacing="12" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CommandHeaderBorderStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="ms-appx:///Assets/Icons/memory.svg" Style="{StaticResource PageHeaderIconStyle}" />
                    <StackPanel Grid.Column="1" Spacing="7">
                        <TextBlock Text="Memory" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing IsActive="True" Width="14" Height="14" />
                            <TextBlock Text="Checking your RAM" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="See what's using your RAM and how to free it up for games." FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource PanelBorderStyle}" Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
            <StackPanel Spacing="10">
                <TextBlock Text="Couldn't check your memory" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" AutomationProperties.AutomationId="MemoryError" />
                <Button Content="Retry" Command="{x:Bind ViewModel.RetryCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="MemoryRetry" />
            </StackPanel>
        </Border>
        <ScrollViewer Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" MaxWidth="1600" HorizontalAlignment="Stretch" Padding="0,0,6,0">
                <ContentControl Content="{x:Bind ViewModel}" ContentTemplate="{StaticResource PageRefreshNoticeTemplate}" HorizontalContentAlignment="Stretch" Visibility="{x:Bind ViewModel.OutOfDateNotice, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                <Border Style="{StaticResource CommandHeaderBorderStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="ms-appx:///Assets/Icons/memory.svg" Style="{StaticResource PageHeaderIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="7">
                            <TextBlock Text="Memory" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind ViewModel.PressureState, Mode=OneWay, Converter={StaticResource RiskToBrush}}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MemoryHeadline, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                            </Grid>
                            <TextBlock Text="See what's using your RAM and how to free it up for games." FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource FocalPanelBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Memory usage" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        <ProgressBar Minimum="0" Maximum="100" Visibility="{x:Bind ViewModel.HasMemory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" Value="{x:Bind ViewModel.MemoryUsedPercent, Mode=OneWay}" Height="8" CornerRadius="4" Foreground="{x:Bind ViewModel.PressureState, Mode=OneWay, Converter={StaticResource RiskToBrush}}" Background="{StaticResource RooIndustriesSurfaceInputBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.MemoryDetail, Mode=OneWay}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <views:MemoryGuidesPanel />
                <views:AdaptivePanel MinColumnWidth="380" MaxColumns="2">
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Apps using the most RAM" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.TopMemoryNote, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.TopMemoryNote, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" AutomationProperties.AutomationId="MemoryTopNote" />
                                <Button Grid.Column="1" Content="Try again" Command="{x:Bind ViewModel.RetryCommand}" VerticalAlignment="Center" AutomationProperties.AutomationId="MemoryTopRetry" />
                            </Grid>
                            <ListView SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" Padding="0" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ItemsSource="{x:Bind ViewModel.TopMemoryRows}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BackgroundRow">
                                        <Grid ColumnSpacing="14" Padding="0,9" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" AutomationProperties.AutomationId="MemoryAppName" />
                                                <TextBlock Text="{x:Bind Role}" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Ram}" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource RooIndustriesTextDisplayBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind StateText}" FontSize="12" FontWeight="Medium" TextAlignment="Right" VerticalAlignment="Center" Foreground="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Tools to check your PC" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                            <ListView SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" Padding="0" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ItemsSource="{x:Bind ViewModel.DiagnosticRows}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiagnosticRow">
                                        <Grid ColumnSpacing="14" Padding="0,9" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Detail}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Go to Tools" Click="OpenTools" Tag="{x:Bind Title}" AutomationProperties.Name="{x:Bind Title}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelBorderStyle}" Visibility="{x:Bind ViewModel.SensorRows.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Sensors" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                            <ListView SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" Padding="0" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ItemsSource="{x:Bind ViewModel.SensorRows}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StatusLine">
                                        <Grid ColumnSpacing="14" Padding="0,7" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="13" Foreground="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </views:AdaptivePanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
