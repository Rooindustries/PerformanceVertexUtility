<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="using:RooIndustries.OptimizationSuite.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RooIndustries.OptimizationSuite.Views.FirmwarePage" xmlns:vm="using:RooIndustries.OptimizationSuite.ViewModels" xmlns:core="using:RooIndustries.Optimizer">
    <Page.Resources>
        <DataTemplate x:Key="FirmwareSettingTemplate" x:DataType="vm:FirmwareSettingRow">
            <Grid Padding="14,10" ColumnSpacing="14" BorderBrush="{StaticResource RooIndustriesBorderBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Help}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind Help}" />
                    <TextBlock Text="{x:Bind VerificationStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesAccentBrush}" />
                    <TextBlock Text="{x:Bind VerificationReason, Mode=OneWay}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind Current}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ComboBox Grid.Column="2" ItemsSource="{x:Bind Options}" DisplayMemberPath="Label" SelectedItem="{x:Bind SelectedOption, Mode=TwoWay}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" Visibility="{x:Bind IsChoice, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind Name}" />
                <TextBox Grid.Column="2" Text="{x:Bind Selection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" Header="{x:Bind NumberHint}" Visibility="{x:Bind IsNumeric, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{x:Bind Name}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="{StaticResource RooIndustriesPageMargin}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CommandHeaderBorderStyle}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="← Tools" Click="Back" VerticalAlignment="Top" IsEnabled="{x:Bind ViewModel.Busy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
            <Image Grid.Column="1" Source="ms-appx:///Assets/Icons/cpu.svg" Style="{StaticResource PageHeaderIconStyle}" />
            <StackPanel Grid.Column="2" Spacing="3">
                <TextBlock Text="BIOS settings" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.Board, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.Bios, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.StepText, Mode=OneWay}" Foreground="{StaticResource RooIndustriesAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.AutomationId="FirmwareStep" />
            <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}" Width="22" Height="22" AutomationProperties.AutomationId="FirmwareBusy" />
        </Grid>
        <Grid Grid.Row="2">
            <ScrollViewer Visibility="{x:Bind ViewModel.IsSetup, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                    <Border Style="{StaticResource PanelBorderStyle}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Load your BIOS settings" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="SCEWIN is downloaded and prepared automatically. Edit settings here, review your changes, then apply them. Your original settings are saved before you make changes." TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PackageText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="FirmwarePackageStatus" />
                            <views:AdaptivePanel MinColumnWidth="220" MaxColumns="2" Compact="True">
                                <Button Content="{x:Bind ViewModel.LoadLabel, Mode=OneWay}" Click="LoadSettings" IsEnabled="{x:Bind ViewModel.CanLoad, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="LoadFirmwareSettings" />
                                <Button Content="Cancel download" Click="CancelSetup" Visibility="{x:Bind ViewModel.CanCancelSetup, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="CancelFirmwareSetup" />
                            </views:AdaptivePanel>
                            <TextBlock Text="Loading checks whether this BIOS supports SCEWIN. Restart is only needed after applying changes." FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" TextWrapping="Wrap" />
                            <Expander Header="Use an existing SCEWIN package" HorizontalAlignment="Stretch">
                                <Button Content="Choose package folder" Click="ChoosePackage" IsEnabled="{x:Bind ViewModel.Busy, Mode=OneWay, Converter={StaticResource InverseBool}}" AutomationProperties.AutomationId="ChooseFirmwarePackage" />
                            </Expander>
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Saved BIOS sessions" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.HistoryHelp, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        <ListView ItemsSource="{x:Bind ViewModel.History}" IsItemClickEnabled="True" ItemClick="OpenHistory" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:FirmwareHistoryRow">
                                    <TextBlock Text="{x:Bind Label}" Padding="0,8" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid RowSpacing="10" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search BIOS settings" AutomationProperties.AutomationId="FirmwareSearch" />
                    <CheckBox Grid.Column="1" Content="Changed only" IsChecked="{x:Bind ViewModel.ChangedOnly, Mode=TwoWay}" />
                </Grid>
                <Grid Grid.Row="1" Padding="14,0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Setting" Style="{StaticResource PanelLabelTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="Current" Style="{StaticResource PanelLabelTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="New value" Style="{StaticResource PanelLabelTextBlockStyle}" />
                </Grid>
                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Settings, Mode=OneWay}" ItemTemplate="{StaticResource FirmwareSettingTemplate}" SelectionMode="None" ItemContainerStyle="{StaticResource StretchListViewItemStyle}" IsEnabled="{x:Bind ViewModel.Busy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                <Expander Grid.Row="3" Header="{x:Bind ViewModel.ExperimentalSummary, Mode=OneWay}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind ViewModel.HasExperimentalSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="FirmwareExperimental">
                    <StackPanel Spacing="8">
                        <TextBlock Text="These settings were refused, did not change, change other settings as a side effect, or were too risky to test. They are kept out of the main list." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        <CheckBox Content="Let me try these anyway" IsChecked="{x:Bind ViewModel.AllowExperimentalEdits, Mode=TwoWay}" AutomationProperties.AutomationId="FirmwareExperimentalOptIn" />
                        <ListView MaxHeight="320" ItemsSource="{x:Bind ViewModel.ExperimentalSettings, Mode=OneWay}" ItemTemplate="{StaticResource FirmwareSettingTemplate}" SelectionMode="None" ItemContainerStyle="{StaticResource StretchListViewItemStyle}" />
                    </StackPanel>
                </Expander>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.ChangesSummary, Mode=OneWay}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Review changes" Click="Review" IsEnabled="{x:Bind ViewModel.CanReview, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ReviewFirmwareChanges" />
                </Grid>
            </Grid>
            <Grid RowSpacing="12" Visibility="{x:Bind ViewModel.IsReview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Confirm these changes" FontSize="18" FontWeight="SemiBold" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Changes}" SelectionMode="None" ItemContainerStyle="{StaticResource StretchListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:FirmwareChange">
                            <Grid Padding="14,12" ColumnSpacing="16" BorderBrush="{StaticResource RooIndustriesBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind BeforeLabel}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="→" />
                                <TextBlock Grid.Column="3" Text="{x:Bind AfterLabel}" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesAccentBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <views:AdaptivePanel Grid.Row="2" HorizontalAlignment="Right" MinColumnWidth="170" MaxColumns="4" Compact="True">
                    <Button Content="Back to settings" Click="Edit" IsEnabled="{x:Bind ViewModel.Busy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                    <Button Content="{x:Bind ViewModel.ApplyLabel, Mode=OneWay}" Click="Apply" IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ApplyFirmwareChanges" />
                </views:AdaptivePanel>
            </Grid>
            <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="{x:Bind ViewModel.ResultHeadline, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="FirmwareResultMessage" />
                <views:AdaptivePanel MinColumnWidth="170" MaxColumns="4" Compact="True">
                    <Button Content="Verify current settings" Click="Verify" IsEnabled="{x:Bind ViewModel.CanVerify, Mode=OneWay}" AutomationProperties.AutomationId="VerifyFirmware" />
                    <Button Content="Restart now" Click="Restart" IsEnabled="{x:Bind ViewModel.CanRestart, Mode=OneWay}" Visibility="{x:Bind ViewModel.CanRestart, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="RestartAfterFirmware" />
                    <Button Content="Review undo" Click="Undo" IsEnabled="{x:Bind ViewModel.CanVerify, Mode=OneWay}" />
                    <Button Content="View settings" Click="OpenSettings" IsEnabled="{x:Bind ViewModel.CanVerify, Mode=OneWay}" />
                </views:AdaptivePanel>
                <TextBlock Text="After restarting, reopen BIOS settings and select this saved session to verify the result." TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="3" BorderBrush="{StaticResource RooIndustriesBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsResult, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" TextWrapping="Wrap" FontSize="12" AutomationProperties.AutomationId="FirmwareMessage" />
                <Button Grid.Column="1" Content="Open saved files" Click="OpenFiles" Visibility="{x:Bind ViewModel.CanOpenFiles, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" IsEnabled="{x:Bind ViewModel.CanOpenFiles, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
