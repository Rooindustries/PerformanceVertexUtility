<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="using:RooIndustries.OptimizationSuite.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RooIndustries.OptimizationSuite.Views.DashboardPage" xmlns:vm="using:RooIndustries.OptimizationSuite.ViewModels">
    <Page.Resources>
        <DataTemplate x:Key="StatusLineTemplate" x:DataType="vm:StatusLine">
            <Grid Padding="0,10" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="UsageLineTemplate" x:DataType="vm:UsageLine">
            <Grid Padding="0,9" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="{StaticResource RooIndustriesPageMargin}" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CommandHeaderBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="28" Height="28" Source="ms-appx:///Assets/Icons/home.svg" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Overview" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Hardware and running apps." Style="{StaticResource PageSubtitleTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBool}}" VerticalAlignment="Top" AutomationProperties.AutomationId="DashboardRefresh" />
        </Grid>
        <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" Width="32" Height="32" />
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="20" Padding="0,0,12,12">
                <views:AdaptivePanel MinColumnWidth="240" MaxColumns="3">
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Width="20" Height="20" Source="ms-appx:///Assets/Icons/memory.svg" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="Memory" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.MemoryValue, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" />
                            <ProgressBar Value="{x:Bind ViewModel.MemoryUsedPercent, Mode=OneWay}" Maximum="100" Height="4" Visibility="{x:Bind ViewModel.HasMemory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{x:Bind ViewModel.MemoryPressureLine, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Width="20" Height="20" Source="ms-appx:///Assets/Icons/activity.svg" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="Processes" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.BackgroundSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Width="20" Height="20" Source="ms-appx:///Assets/Icons/game.svg" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="Running game" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.GameName, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Button Content="Game settings" Tag="profiles" Click="OnDashboardActionClick" AutomationProperties.Name="Open game settings" />
                        </StackPanel>
                    </Border>
                </views:AdaptivePanel>
                <views:AdaptivePanel MinColumnWidth="380" MaxColumns="2">
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Hardware" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DriverLines}" ItemTemplate="{StaticResource StatusLineTemplate}" />
                            <Button Content="Drivers &amp; GPU" Tag="drivers" Click="OnDashboardActionClick" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Largest processes" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.TopMemoryUsers}" ItemTemplate="{StaticResource UsageLineTemplate}" />
                            <Button Content="All processes" Tag="profiles" Click="OnProcessesClick" />
                        </StackPanel>
                    </Border>
                </views:AdaptivePanel>
                <StackPanel Spacing="12">
                    <TextBlock Text="Tools &amp; settings" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <views:AdaptivePanel MinColumnWidth="240" MaxColumns="4">
                        <Button Tag="uninstall" Click="OnDashboardActionClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" AutomationProperties.Name="Installed apps">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="24" Height="24" Source="ms-appx:///Assets/Icons/apps.svg" AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="Installed apps" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Uninstall apps and scan leftovers" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Tag="monitoring" Click="OnDashboardActionClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" AutomationProperties.Name="Timer &amp; cache">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="24" Height="24" Source="ms-appx:///Assets/Icons/timer.svg" AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="Timer &amp; cache" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Timer and shader cache controls" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Tag="tools" Click="OnDashboardActionClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" AutomationProperties.Name="Tools">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="24" Height="24" Source="ms-appx:///Assets/Icons/tools.svg" AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="Tools" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Open diagnostics and utilities" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Tag="restore" Click="OnDashboardActionClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" AutomationProperties.Name="Backups &amp; history">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="24" Height="24" Source="ms-appx:///Assets/Icons/history.svg" AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="Backups &amp; history" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Review changes and saved settings" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </views:AdaptivePanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
