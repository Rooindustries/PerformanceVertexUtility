<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="using:RooIndustries.OptimizationSuite.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RooIndustries.OptimizationSuite.Views.PerformanceProfilesPage" xmlns:vm="using:RooIndustries.OptimizationSuite.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Page.Resources>
        <DataTemplate x:Key="GtRowTemplate" x:DataType="vm:GameAppRow">
            <Grid Padding="14,11" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" VerticalAlignment="Center" Background="{x:Bind PlanState, Converter={StaticResource RiskToBrush}}" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind PlanWithRam}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind PlanState, Converter={StaticResource RiskToBrush}}" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind Role}" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{x:Bind Priority}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="{StaticResource RooIndustriesPageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CommandHeaderBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Assets/Icons/game.svg" Style="{StaticResource PageHeaderIconStyle}" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Games &amp; processes" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Set priorities, choose CPU cores, and manage saved rules." Style="{StaticResource PageSubtitleTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
        <TabView x:Name="ProcessTabs" Grid.Row="1" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.AutomationId="ProcessTabs">
            <TabViewItem Header="Games" IsClosable="False" AutomationProperties.AutomationId="GamesTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="0,12,12,12">
                    <StackPanel Spacing="16">
                        <views:GameSessionPanel />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Processes" IsClosable="False" AutomationProperties.AutomationId="ProcessesTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="0,12,12,12">
                    <StackPanel Spacing="16">
                        <views:ProcessControlsPanel x:Name="ApplicationControls" />
                        <Expander Header="Restore earlier CPU settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind ApplicationControls.ViewModel.HasLegacyCpuRecovery, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <views:CpuSetsPanel />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Background apps" IsClosable="False" AutomationProperties.AutomationId="BackgroundTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="0,12,12,12">
                    <StackPanel Spacing="12">
                        <ContentControl Content="{x:Bind ViewModel}" ContentTemplate="{StaticResource PageRefreshNoticeTemplate}" HorizontalContentAlignment="Stretch" Visibility="{x:Bind ViewModel.OutOfDateNotice, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="28" Height="28" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                        <StackPanel Spacing="16" x:Name="ProcessContent" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource CommandHeaderBorderStyle}">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooIndustriesAccentBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <TextBlock Text="Background priorities" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind ViewModel.GameStatusLevel, Mode=OneWay, Converter={StaticResource RiskToBrush}}" />
                                                    <TextBlock Text="{x:Bind ViewModel.GameStatus, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.RuleSummary, Mode=OneWay}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border CornerRadius="8" BorderThickness="1" Padding="14" Background="{StaticResource RooIndustriesSurfaceInputBrush}" BorderBrush="{StaticResource RooIndustriesBorderBrush}">
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind ViewModel.ActionTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.ActionDetail, Mode=OneWay}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                            </StackPanel>
                                            <views:AdaptivePanel MinColumnWidth="150" MaxColumns="4" Compact="True">
                                                <ComboBox IsEnabled="{x:Bind ViewModel.CanSelectPreset, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.ProcessPresetIndex, Mode=TwoWay}" AutomationProperties.AutomationId="BackgroundPriorityPreset" AutomationProperties.Name="Background app preset" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="Lower background apps" />
                                                    <ComboBoxItem Content="{x:Bind ViewModel.PlacementLabel, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.PlacementAvailable, Mode=OneWay}" />
                                                </ComboBox>
                                                <Button Command="{x:Bind ViewModel.PreviewPlanCommand}" Padding="12,8" AutomationProperties.Name="Review process changes" IsEnabled="{x:Bind ViewModel.CanRunProcessAction, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <Image Width="14" Height="14" Source="ms-appx:///Assets/Icons/search.svg" AutomationProperties.AccessibilityView="Raw" />
                                                        <TextBlock Text="Review" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{x:Bind ViewModel.ApplyProfileCommand}" Padding="12,8" AutomationProperties.Name="Apply" IsEnabled="{x:Bind ViewModel.CanRunProcessAction, Mode=OneWay}" Background="{StaticResource RooIndustriesNavCtaBrush}" Foreground="{StaticResource RooIndustriesOnCtaBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <Image Width="14" Height="14" Source="ms-appx:///Assets/Icons/play.svg" AutomationProperties.AccessibilityView="Raw" />
                                                        <TextBlock Text="Apply" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{x:Bind ViewModel.RestoreProfileCommand}" Padding="12,8" AutomationProperties.Name="Restore" IsEnabled="{x:Bind ViewModel.CanRestoreProfile, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <Image Width="14" Height="14" Source="ms-appx:///Assets/Icons/undo.svg" AutomationProperties.AccessibilityView="Raw" />
                                                        <TextBlock Text="Restore" />
                                                    </StackPanel>
                                                </Button>
                                            </views:AdaptivePanel>
                                            <TextBlock Text="{x:Bind ViewModel.PlacementReason, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.ActionBusy, Mode=OneWay}" Width="18" Height="18" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RestoreHint, Mode=OneWay}" FontSize="11" LineHeight="16" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <views:AdaptivePanel MinColumnWidth="370" MaxColumns="2">
                                        <Border CornerRadius="8" BorderThickness="1" Padding="14" Background="{StaticResource RooIndustriesSurfaceInputBrush}" BorderBrush="{StaticResource RooIndustriesBorderBrush}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="Game priority" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.MatchTuneStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesAccentBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind ViewModel.MatchTuneDetail, Mode=OneWay}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                                </StackPanel>
                                                <views:AdaptivePanel MinColumnWidth="150" MaxColumns="4" Compact="True">
                                                    <Button Command="{x:Bind ViewModel.CheckMatchTuneCommand}" Padding="10,8" AutomationProperties.Name="Review game priority" IsEnabled="{x:Bind ViewModel.CanCheckMatchTune, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Image Width="13" Height="13" Source="ms-appx:///Assets/Icons/search.svg" AutomationProperties.AccessibilityView="Raw" />
                                                            <TextBlock Text="Review" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{x:Bind ViewModel.StartMatchTuneCommand}" Padding="10,8" AutomationProperties.Name="Start game priority" IsEnabled="{x:Bind ViewModel.CanStartMatchTune, Mode=OneWay}" Background="{StaticResource RooIndustriesNavCtaBrush}" Foreground="{StaticResource RooIndustriesOnCtaBrush}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Image Width="13" Height="13" Source="ms-appx:///Assets/Icons/play.svg" AutomationProperties.AccessibilityView="Raw" />
                                                            <TextBlock Text="Start" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{x:Bind ViewModel.RestoreMatchTuneCommand}" Padding="10,8" AutomationProperties.Name="Restore game priority" IsEnabled="{x:Bind ViewModel.CanRestoreMatchTune, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Image Width="13" Height="13" Source="ms-appx:///Assets/Icons/undo.svg" AutomationProperties.AccessibilityView="Raw" />
                                                            <TextBlock Text="Restore" />
                                                        </StackPanel>
                                                    </Button>
                                                </views:AdaptivePanel>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="8" BorderThickness="1" Padding="14" Background="{StaticResource RooIndustriesSurfaceInputBrush}" BorderBrush="{StaticResource RooIndustriesBorderBrush}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="Background limits" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.GovernorStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesAccentBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind ViewModel.GovernorDetail, Mode=OneWay}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                                </StackPanel>
                                                <views:AdaptivePanel MinColumnWidth="150" MaxColumns="4" Compact="True">
                                                    <Button Command="{x:Bind ViewModel.CheckGovernorCommand}" Padding="10,8" AutomationProperties.Name="Review background limits" IsEnabled="{x:Bind ViewModel.CanCheckGovernor, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Image Width="13" Height="13" Source="ms-appx:///Assets/Icons/search.svg" AutomationProperties.AccessibilityView="Raw" />
                                                            <TextBlock Text="Review" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{x:Bind ViewModel.StartGovernorCommand}" Padding="10,8" AutomationProperties.Name="Start background limits" IsEnabled="{x:Bind ViewModel.CanStartGovernor, Mode=OneWay}" Background="{StaticResource RooIndustriesNavCtaBrush}" Foreground="{StaticResource RooIndustriesOnCtaBrush}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Image Width="13" Height="13" Source="ms-appx:///Assets/Icons/play.svg" AutomationProperties.AccessibilityView="Raw" />
                                                            <TextBlock Text="Start" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{x:Bind ViewModel.RestoreGovernorCommand}" Padding="10,8" AutomationProperties.Name="Restore background limits" IsEnabled="{x:Bind ViewModel.CanRestoreGovernor, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Image Width="13" Height="13" Source="ms-appx:///Assets/Icons/undo.svg" AutomationProperties.AccessibilityView="Raw" />
                                                            <TextBlock Text="Restore" />
                                                        </StackPanel>
                                                    </Button>
                                                </views:AdaptivePanel>
                                            </StackPanel>
                                        </Border>
                                    </views:AdaptivePanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Padding="0">
                                <StackPanel>
                                    <StackPanel Padding="18,16" Spacing="12">
                                        <TextBlock FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}">
                                            <Run Text="{x:Bind ViewModel.AppsCount, Mode=OneWay}" />
                                            <Run Text=" apps" />
                                            <Run Text="  /  " />
                                            <Run Text="{x:Bind ViewModel.KeepCount, Mode=OneWay}" />
                                            <Run Text=" excluded" />
                                            <Run Text="  /  " />
                                            <Run Text="{x:Bind ViewModel.QuietCount, Mode=OneWay}" />
                                            <Run Text=" can use lower priority" />
                                        </TextBlock>
                                        <TextBox PlaceholderText="Search apps" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Grid Padding="14,10" ColumnSpacing="12" Background="{StaticResource RooIndustriesSurfaceElevatedBrush}" BorderThickness="0,1,0,1" BorderBrush="{StaticResource RooIndustriesBorderBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.4*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="App" Margin="13,0,0,0" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="Role" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                        <TextBlock Grid.Column="2" Text="Priority" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                    </Grid>
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows}" ItemTemplate="{StaticResource GtRowTemplate}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
