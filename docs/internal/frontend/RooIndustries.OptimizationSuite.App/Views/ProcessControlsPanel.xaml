<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="using:RooIndustries.OptimizationSuite.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RooIndustries.OptimizationSuite.Views.ProcessControlsPanel" xmlns:vm="using:RooIndustries.OptimizationSuite.ViewModels">
    <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource RooIndustriesSurfaceCardBrush}" BorderBrush="{StaticResource RooIndustriesBorderBrush}">
        <StackPanel Spacing="14">
            <TextBlock Text="Running process" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
            <TextBlock Text="Review priorities and CPU placement for a running app, or save a rule for future launches." TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{x:Bind ViewModel.Processes}" SelectedItem="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}" PlaceholderText="Choose a running application" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ProcessPicker" AutomationProperties.Name="Running app" Header="Running app" />
                <Button Grid.Column="1" Content="Refresh" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ProcessRefresh" />
            </Grid>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Controls}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <views:AdaptivePanel MinColumnWidth="230" MaxColumns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProcessControlRow">
                        <StackPanel Spacing="5" Margin="0,0,14,12">
                            <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                            <ComboBox ItemsSource="{x:Bind Options}" SelectedItem="{x:Bind Selected, Mode=TwoWay}" IsEnabled="{x:Bind Available, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="{x:Bind Name}" AutomationProperties.Name="{x:Bind Label}" />
                            <TextBlock Text="{x:Bind Current, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Current, Mode=OneWay}" FontSize="11" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="CPU cores" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ProcessCoresExpander">
                <ContentControl HorizontalContentAlignment="Stretch" Visibility="{x:Bind ViewModel.HasProcess, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Preferred CPU cores" ItemsSource="{x:Bind ViewModel.CpuModes}" SelectedItem="{x:Bind ViewModel.SelectedCpuMode, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditCpuSelection, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ProcessCpuMode" />
                            <ComboBox Grid.Column="1" Header="Processor group" ItemsSource="{x:Bind ViewModel.TopologyChoices}" SelectedItem="{x:Bind ViewModel.SelectedTopology, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditCpuSelection, Mode=OneWay}" HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.ShowTopology, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ProcessTopology" />
                        </Grid>
                        <CheckBox Content="One logical processor per physical core" IsChecked="{x:Bind ViewModel.OneThreadPerCore, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditCpuSelection, Mode=OneWay}" AutomationProperties.AutomationId="ProcessOneThread" />
                        <CheckBox Content="Restrict this app to selected CPUs" IsChecked="{x:Bind ViewModel.SetHardAffinity, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditAffinity, Mode=OneWay}" AutomationProperties.AutomationId="ProcessHardAffinity" />
                        <StackPanel Spacing="8" IsEnabled="{x:Bind ViewModel.CanEditAffinity, Mode=OneWay}" Visibility="{x:Bind ViewModel.SetHardAffinity, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Header="{x:Bind ViewModel.AffinityLabel, Mode=OneWay}" Text="{x:Bind ViewModel.AffinityMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="For example, 0x1 selects CPU 0" AutomationProperties.AutomationId="ProcessAffinityMask" />
                            <Button Content="Use selected CPUs" Command="{x:Bind ViewModel.UseCheckedAffinityCommand}" AutomationProperties.AutomationId="ProcessBuildAffinity" />
                        </StackPanel>
                        <GridView ItemsSource="{x:Bind ViewModel.Cpus}" SelectionMode="None" IsEnabled="{x:Bind ViewModel.CanEditCpuChoices, Mode=OneWay}" MaxHeight="240" HorizontalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.ShowLogicalCpus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ProcessCpuChoices">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogicalCpuChoice">
                                    <CheckBox IsChecked="{x:Bind Selected, Mode=TwoWay}" IsEnabled="{x:Bind Cpu.Available}" Width="194" AutomationProperties.Name="{x:Bind Label}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Label}" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Detail}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <TextBlock Text="CPU Sets are preferences. Hard affinity and thread-specific choices can further restrict placement. Memory priority affects page retention, not a RAM limit." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                    </StackPanel>
                </ContentControl>
            </Expander>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" AutomationProperties.AutomationId="ProcessStatus" />
            <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" AutomationProperties.AutomationId="ProcessDetail" />
            <Border Padding="12" CornerRadius="8" Background="{StaticResource RooIndustriesSurfaceInputBrush}" Visibility="{x:Bind ViewModel.HasReview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Bind ViewModel.ReviewSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextSecondaryBrush}" AutomationProperties.AutomationId="ProcessReview" />
            </Border>
            <views:AdaptivePanel MinColumnWidth="170" MaxColumns="4" Compact="True">
                <Button Content="Review changes" Command="{x:Bind ViewModel.PreviewCommand}" IsEnabled="{x:Bind ViewModel.CanPreview, Mode=OneWay}" AutomationProperties.AutomationId="ProcessPreview" />
                <Button Content="Apply once" Command="{x:Bind ViewModel.ApplyCommand}" IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}" AutomationProperties.AutomationId="ProcessApply" Background="{StaticResource RooIndustriesNavCtaBrush}" Foreground="{StaticResource RooIndustriesOnCtaBrush}" />
                <Button Content="Restore settings" Command="{x:Bind ViewModel.RestoreCommand}" IsEnabled="{x:Bind ViewModel.CanRestore, Mode=OneWay}" AutomationProperties.AutomationId="ProcessRestore" />
            </views:AdaptivePanel>
            <Expander Header="Saved rules" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ProcessSavedRules">
                <StackPanel Spacing="12">
                    <TextBox Header="Rule name" Text="{x:Bind ViewModel.RuleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ProcessRuleName" />
                    <CheckBox Content="Match this executable name in any folder" IsChecked="{x:Bind ViewModel.MatchFilename, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                    <CheckBox Content="Require the reviewed executable file hash" IsChecked="{x:Bind ViewModel.PinExecutable, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                    <Button Content="Save and start rule" Command="{x:Bind ViewModel.SaveRuleCommand}" IsEnabled="{x:Bind ViewModel.CanSaveRule, Mode=OneWay}" AutomationProperties.AutomationId="ProcessSaveRule" />
                    <TextBlock Text="Rules continue after you close the app. Pause or delete a rule to restore settings that have not changed elsewhere." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                    <ComboBox Header="Existing rules" ItemsSource="{x:Bind ViewModel.Rules}" SelectedItem="{x:Bind ViewModel.SelectedRule, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ProcessRulesList" />
                    <TextBlock Text="{x:Bind ViewModel.RuleDetail, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextMutedBrush}" />
                    <views:AdaptivePanel MinColumnWidth="170" MaxColumns="4" Compact="True">
                        <Button Content="Edit rule" Command="{x:Bind ViewModel.EditRuleCommand}" IsEnabled="{x:Bind ViewModel.CanManageRule, Mode=OneWay}" AutomationProperties.AutomationId="ProcessEditRule" />
                        <Button Content="Pause / resume" Command="{x:Bind ViewModel.ToggleRuleCommand}" IsEnabled="{x:Bind ViewModel.CanManageRule, Mode=OneWay}" AutomationProperties.AutomationId="ProcessToggleRule" />
                        <Button Content="Delete rule" Command="{x:Bind ViewModel.DeleteRuleCommand}" IsEnabled="{x:Bind ViewModel.CanManageRule, Mode=OneWay}" AutomationProperties.AutomationId="ProcessDeleteRule" />
                    </views:AdaptivePanel>
                    <TextBlock Text="{x:Bind ViewModel.WorkerSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RooIndustriesTextPrimaryBrush}" AutomationProperties.AutomationId="ProcessWorkerStatus" />
                    <views:AdaptivePanel MinColumnWidth="170" MaxColumns="4" Compact="True">
                        <Button Content="Enable saved rules" Command="{x:Bind ViewModel.WorkerCommand}" CommandParameter="Start" IsEnabled="{x:Bind ViewModel.CanManageWorker, Mode=OneWay}" />
                        <Button Content="Stop and restore" Command="{x:Bind ViewModel.WorkerCommand}" CommandParameter="Stop" IsEnabled="{x:Bind ViewModel.CanManageWorker, Mode=OneWay}" AutomationProperties.AutomationId="ProcessStopWorker" />
                        <Button Content="{x:Bind ViewModel.LogonLabel, Mode=OneWay}" Command="{x:Bind ViewModel.WorkerCommand}" CommandParameter="Logon" IsEnabled="{x:Bind ViewModel.CanManageWorker, Mode=OneWay}" />
                        <Button Content="Refresh" Command="{x:Bind ViewModel.WorkerCommand}" CommandParameter="Status" IsEnabled="{x:Bind ViewModel.CanManageWorker, Mode=OneWay}" />
                    </views:AdaptivePanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
