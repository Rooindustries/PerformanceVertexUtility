<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Roo.OptimizationSuite.Converters">

    <conv:RiskToBrushConverter x:Key="RiskToBrush" />
    <conv:RiskToDisplayConverter x:Key="RiskToDisplay" />
    <conv:BytesToReadableConverter x:Key="BytesToReadable" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    <conv:CountToInverseVisibilityConverter x:Key="CountToInverseVisibility" />

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RooFontFamily}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource RooFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource RooFontFamily}" />
    </Style>

    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RooFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="36" />
    </Style>

    <Style x:Key="PageSubtitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RooFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="SectionHeaderTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RooFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="MetricValueTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RooFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="30" />
    </Style>

    <Style x:Key="MetricLabelTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RooFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RooFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="DisplayHeadingTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RooFontFamily}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="42" />
    </Style>

    <Style x:Key="HeroSubtextTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RooFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style x:Key="NavCtaButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,9,16,9" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource RooFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <ThemeShadow x:Key="RooPanelShadow" />

    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{StaticResource RooSurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RooBorderBrush}" />
        <Setter Property="Shadow" Value="{StaticResource RooPanelShadow}" />
    </Style>

    <Style x:Key="FocalPanelBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Background" Value="{StaticResource RooSurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RooBorderAccentBrush}" />
        <Setter Property="Shadow" Value="{StaticResource RooPanelShadow}" />
    </Style>

    <Style x:Key="CommandHeaderBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="24,20" />
        <Setter Property="Background" Value="{StaticResource RooGlassMenuBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RooBorderBrush}" />
        <Setter Property="Shadow" Value="{StaticResource RooPanelShadow}" />
    </Style>

    <Style x:Key="PanelLabelTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RooFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="70" />
        <Setter Property="LineHeight" Value="15" />
    </Style>

</ResourceDictionary>
