<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="CapabilityRowTemplate">
        <Grid Padding="0,7" ColumnSpacing="10" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Ellipse Grid.Column="0"
                     Width="7"
                     Height="7"
                     Margin="0,7,0,0"
                     VerticalAlignment="Top"
                     Fill="{Binding DotState, Converter={StaticResource RiskToBrush}}" />

            <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{Binding Label}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource RooTextPrimaryBrush}" />
                <TextBlock Text="{Binding StatusLine}"
                           FontSize="12"
                           LineHeight="17"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource RooTextMutedBrush}" />
                <TextBlock Text="{Binding ReasonOrNextStep}"
                           FontSize="12"
                           LineHeight="17"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource RooTextMutedBrush}"
                           Visibility="{Binding ReasonOrNextStep, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
