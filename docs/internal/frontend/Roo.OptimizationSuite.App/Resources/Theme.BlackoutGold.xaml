<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="RooCanvasBrush" Color="#030303" />
    <SolidColorBrush x:Key="RooCanvasDeepBrush" Color="#070707" />
    <LinearGradientBrush x:Key="RooAppBackgroundBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Offset="0.0" Color="#0A0A0A" />
        <GradientStop Offset="0.3" Color="#060606" />
        <GradientStop Offset="0.65" Color="#030303" />
        <GradientStop Offset="1.0" Color="#000000" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="RooSurfaceBrush" Color="#0D0D0D" />
    <SolidColorBrush x:Key="RooSurfaceElevatedBrush" Color="#090909" />
    <SolidColorBrush x:Key="RooSurfaceInputBrush" Color="#0C0C0C" />
    <SolidColorBrush x:Key="RooSurfaceHoverBrush" Color="#0DFFFFFF" />

    <LinearGradientBrush x:Key="RooSurfaceCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#F0181818" />
        <GradientStop Offset="1.0" Color="#E0050505" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RooGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#F0181818" />
        <GradientStop Offset="1.0" Color="#E0050505" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RooGlassMenuBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#F70E0E0E" />
        <GradientStop Offset="1.0" Color="#EB070707" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RooGlassHighlightBrush" Color="#29FFFFFF" />

    <SolidColorBrush x:Key="RooBorderBrush" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="RooBorderStrongBrush" Color="#42FFFFFF" />
    <SolidColorBrush x:Key="RooBorderAccentBrush" Color="#52F0C35A" />

    <SolidColorBrush x:Key="RooTextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RooTextSecondaryBrush" Color="#DEDED7" />
    <SolidColorBrush x:Key="RooTextMutedBrush" Color="#8F8F86" />
    <SolidColorBrush x:Key="RooTextDisplayBrush" Color="#F7F7F2" />
    <SolidColorBrush x:Key="RooTextAccentBrush" Color="#F7F7F2" />

    <SolidColorBrush x:Key="RooAccentBrush" Color="#E8B94A" />
    <SolidColorBrush x:Key="RooAccentStrongBrush" Color="#C9962E" />
    <SolidColorBrush x:Key="RooAccentGlowBrush" Color="#FFD76E" />
    <SolidColorBrush x:Key="RooAccentSoftBrush" Color="#66F0C35A" />
    <SolidColorBrush x:Key="RooOnAccentBrush" Color="#161208" />
    <LinearGradientBrush x:Key="RooPrimaryButtonBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#FFD76E" />
        <GradientStop Offset="0.5" Color="#E8B94A" />
        <GradientStop Offset="1.0" Color="#C9962E" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="RooSuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="RooWarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="RooDangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="RooInfoBrush" Color="#E8C97A" />

    <SolidColorBrush x:Key="RiskSafeBrush" Color="#34D399" />
    <SolidColorBrush x:Key="RiskSafeSoftBrush" Color="#1410B981" />
    <SolidColorBrush x:Key="RiskSafeBorderBrush" Color="#6110B981" />

    <SolidColorBrush x:Key="RiskLowBrush" Color="#E8C97A" />
    <SolidColorBrush x:Key="RiskLowSoftBrush" Color="#17E8B94A" />
    <SolidColorBrush x:Key="RiskLowBorderBrush" Color="#73F0C35A" />

    <SolidColorBrush x:Key="RiskMediumBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="RiskMediumSoftBrush" Color="#1AFBBF24" />
    <SolidColorBrush x:Key="RiskMediumBorderBrush" Color="#57FBBF24" />

    <SolidColorBrush x:Key="RiskHighBrush" Color="#F87171" />
    <SolidColorBrush x:Key="RiskHighSoftBrush" Color="#14EF4444" />
    <SolidColorBrush x:Key="RiskHighBorderBrush" Color="#61EF4444" />

    <SolidColorBrush x:Key="RiskProtectedBrush" Color="#E8B94A" />
    <SolidColorBrush x:Key="RiskProtectedSoftBrush" Color="#14F0C35A" />
    <SolidColorBrush x:Key="RiskProtectedBorderBrush" Color="#52F0C35A" />

    <SolidColorBrush x:Key="RiskBlockedBrush" Color="#F87171" />
    <SolidColorBrush x:Key="RiskBlockedSoftBrush" Color="#14EF4444" />
    <SolidColorBrush x:Key="RiskBlockedBorderBrush" Color="#61EF4444" />

    <SolidColorBrush x:Key="RiskNeutralBrush" Color="#8F8F86" />
    <SolidColorBrush x:Key="RiskNeutralSoftBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="RiskNeutralBorderBrush" Color="#42FFFFFF" />

    <LinearGradientBrush x:Key="RooNavCtaBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#1C1C20" />
        <GradientStop Offset="1.0" Color="#121215" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RooNavCtaHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#26262B" />
        <GradientStop Offset="1.0" Color="#18181C" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RooDisplayTextBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#FFF3CD" />
        <GradientStop Offset="0.28" Color="#FFD76E" />
        <GradientStop Offset="0.52" Color="#E8B94A" />
        <GradientStop Offset="0.74" Color="#C9962E" />
        <GradientStop Offset="1.0" Color="#FFE9A8" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RooMetalDisplayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FFFFFF" />
        <GradientStop Offset="0.52" Color="#ECEEE9" />
        <GradientStop Offset="1.0" Color="#C0C4C2" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RooGoldFlairBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#FFF3CD" />
        <GradientStop Offset="0.5" Color="#FFD76E" />
        <GradientStop Offset="1.0" Color="#E8B94A" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="RooAppRadialBrush" Center="0.5,0.0" GradientOrigin="0.5,0.0" RadiusX="1.1" RadiusY="0.85">
        <GradientStop Offset="0.0" Color="#14FFFAF0" />
        <GradientStop Offset="1.0" Color="#00FFFAF0" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="RooNavbarBorderRestBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="RooNavbarBorderScrolledBrush" Color="#2EF0C35A" />

</ResourceDictionary>
