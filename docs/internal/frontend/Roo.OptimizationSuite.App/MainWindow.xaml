<Window
    x:Class="Roo.OptimizationSuite.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="{StaticResource RooCanvasDeepBrush}">
        <Rectangle x:Name="RadialOverlay" Fill="{StaticResource RooAppRadialBrush}" IsHitTestVisible="False" />

        <NavigationView
            x:Name="Nav"
            FontFamily="{StaticResource RooFontFamily}"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="248"
            SelectionChanged="Nav_SelectionChanged">

            <NavigationView.Resources>
                <StaticResource x:Key="FocusVisualPrimaryBrush" ResourceKey="RooFocusVisualBrush" />
                <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="Transparent" />
                <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="RooFocusVisualBrush" />
                <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent" />
                <StaticResource x:Key="NavigationViewItemForegroundFocus" ResourceKey="RooTextPrimaryBrush" />
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <Grid Padding="4,12,4,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="LogoImage" Grid.Column="0" Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="ROO INDUSTRIES" FontFamily="{StaticResource RooFontFamily}"
                                   FontSize="13" FontWeight="SemiBold" CharacterSpacing="80"
                                   Foreground="{StaticResource RooTextPrimaryBrush}" />
                        <TextBlock Text="Optimization Suite" FontFamily="{StaticResource RooFontFamily}"
                                   FontSize="11" Foreground="{StaticResource RooTextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Process Control" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Apps &amp; Cleanup" Tag="uninstall">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Startup &amp; Services" Tag="startup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Drivers &amp; GPU" Tag="drivers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Memory &amp; Latency" Tag="memory">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Windows Tweaks" Tag="monitoring">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tools &amp; Diagnostics" Tag="tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Restore &amp; Logs" Tag="restore">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Top" Fill="{StaticResource RooTopHairlineBrush}" />
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
