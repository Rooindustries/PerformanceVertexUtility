<Window
    x:Class="Roo.OptimizationSuite.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="{StaticResource RooCanvasDeepBrush}">
        <Rectangle x:Name="RadialOverlay" Fill="{StaticResource RooAppRadialBrush}" IsHitTestVisible="False" />

        <NavigationView
            x:Name="Nav"
            FontFamily="{StaticResource RooFontFamily}"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="248"
            SelectionChanged="Nav_SelectionChanged">

            <NavigationView.PaneHeader>
                <Grid Padding="4,12,4,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                            Background="{StaticResource RooGlassBrush}"
                            BorderBrush="{StaticResource RooBorderAccentBrush}" BorderThickness="1">
                        <Image x:Name="LogoImage" Width="24" Height="24" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="ROO INDUSTRIES" FontFamily="{StaticResource RooFontFamily}"
                                   FontSize="13" FontWeight="SemiBold" CharacterSpacing="80"
                                   Foreground="{StaticResource RooTextPrimaryBrush}" />
                        <TextBlock Text="Optimization Suite" FontFamily="{StaticResource RooFontFamily}"
                                   FontSize="11" Foreground="{StaticResource RooTextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Game Tune" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Clean Junk" Tag="uninstall">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Drivers &amp; Settings" Tag="drivers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Live Feel" Tag="monitoring">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Before &amp; After" Tag="reports">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Top">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.0" Color="#00000000" />
                            <GradientStop Offset="0.5" Color="#8067E8F9" />
                            <GradientStop Offset="1.0" Color="#00000000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
