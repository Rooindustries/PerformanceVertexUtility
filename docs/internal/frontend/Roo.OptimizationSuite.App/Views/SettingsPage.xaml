<Page
    x:Class="Roo.OptimizationSuite.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Roo.OptimizationSuite.Models"
    xmlns:vm="using:Roo.OptimizationSuite.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="{StaticResource RooPageMargin}">
        <ScrollViewer>
            <StackPanel Spacing="18" MaxWidth="860" HorizontalAlignment="Left">

                <Border Style="{StaticResource CommandHeaderBorderStyle}" Translation="0,0,32">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooAccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource RooTextPrimaryBrush}" />
                                <TextBlock Text="Theme, safety, and the Roo identity." FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                           Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="APPEARANCE" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="Theme" FontWeight="SemiBold" Foreground="{StaticResource RooTextPrimaryBrush}" />
                                <TextBlock Text="Roo Blue is the default. Blackout is the darker match-night setup." Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="220" VerticalAlignment="Center"
                                      ItemsSource="{x:Bind ViewModel.Themes}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{x:Bind ViewModel.SelectedThemeId, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="Reduced effects" FontWeight="SemiBold" Foreground="{StaticResource RooTextPrimaryBrush}" />
                                <TextBlock Text="Turns down glow and blur so weaker GPUs keep more room for the game." Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ReducedEffects, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16" Padding="0">
                    <StackPanel>
                        <StackPanel Padding="20,18,20,10" Spacing="6">
                            <TextBlock Text="OPTIMIZATION ENGINE" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.EngineStatus, Mode=OneWay}" FontSize="13" LineHeight="19"
                                       Foreground="{StaticResource RooTextSecondaryBrush}" />
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.EngineRows}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatusLine">
                                    <Grid Padding="20,11" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Label}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   TextAlignment="Right" Foreground="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock Text="Roo's backend runs in short, bounded sessions and exits. Apply actions stay preview-first — nothing changes until you confirm it."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" Padding="20,10,20,18" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16" Padding="0">
                    <StackPanel>
                        <TextBlock Text="SAFETY DEFAULTS" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}"
                                   Padding="20,18,20,8" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SafetyRows}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SafetyRow">
                                    <Grid Padding="20,12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Label}" VerticalAlignment="Center" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="PRODUCT IDENTITY" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ProductName, Mode=OneWay}" FontSize="16" LineHeight="22" FontWeight="SemiBold" Foreground="{StaticResource RooTextDisplayBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Tagline}" Foreground="{StaticResource RooTextSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        <TextBlock Text="Roo Industries / rooindustries.com" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
