<Page
    x:Class="Roo.OptimizationSuite.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Roo.OptimizationSuite.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="{StaticResource RooPageMargin}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18" MaxWidth="860" HorizontalAlignment="Left">

                <Border Style="{StaticResource CommandHeaderBorderStyle}" Translation="0,0,32">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooAccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Foreground="{StaticResource RooTextPrimaryBrush}" />
                                <TextBlock Text="Blackout Gold, capability sources, and safety gates." FontSize="13" LineHeight="19"
                                           TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="APPEARANCE" Style="{StaticResource PanelLabelTextBlockStyle}"
                                   Foreground="{StaticResource RooTextMutedBrush}" TextWrapping="Wrap" />
                        <StackPanel Spacing="5">
                            <TextBlock Text="Theme" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource RooTextPrimaryBrush}" />
                            <TextBlock Text="Blackout Gold is the only theme in this build." Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="Reduced effects" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{StaticResource RooTextPrimaryBrush}" />
                                <TextBlock Text="Turns down glow and blur while keeping the Blackout Gold palette."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ReducedEffects, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16" Padding="0">
                    <StackPanel>
                        <StackPanel Padding="20,18,20,10" Spacing="6">
                            <TextBlock Text="HOW ROO WORKS" Style="{StaticResource PanelLabelTextBlockStyle}"
                                       Foreground="{StaticResource RooTextMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.EngineStatus, Mode=OneWay}" FontSize="13" LineHeight="19"
                                       TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.EngineRows}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatusLine">
                                    <Grid Padding="20,11" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.25*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Label}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   TextAlignment="Right" TextWrapping="Wrap"
                                                   Foreground="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock Text="When a capability can act, it previews first. Approval and restore status are shown per capability."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}"
                                   Padding="20,10,20,18" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16" Padding="0">
                    <StackPanel>
                        <TextBlock Text="SAFETY DEFAULTS" Style="{StaticResource PanelLabelTextBlockStyle}"
                                   Foreground="{StaticResource RooTextMutedBrush}" Padding="20,18,20,8" TextWrapping="Wrap" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SafetyRows}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SafetyRow">
                                    <Grid Padding="20,12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Label}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   TextAlignment="Right" TextWrapping="Wrap"
                                                   Foreground="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="ABOUT" Style="{StaticResource PanelLabelTextBlockStyle}"
                                   Foreground="{StaticResource RooTextMutedBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ProductName, Mode=OneWay}" FontSize="16" LineHeight="22"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource RooTextDisplayBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Tagline}" TextWrapping="Wrap"
                                   Foreground="{StaticResource RooTextSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{StaticResource RooTextMutedBrush}" />
                        <TextBlock Text="Roo Industries / rooindustries.com" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{StaticResource RooTextMutedBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
