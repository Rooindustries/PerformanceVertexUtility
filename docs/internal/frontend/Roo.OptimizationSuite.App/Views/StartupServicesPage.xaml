<Page
    x:Class="Roo.OptimizationSuite.Views.StartupServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Roo.OptimizationSuite.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="{StaticResource RooPageMargin}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Reading startup and services" Foreground="{StaticResource RooTextMutedBrush}" />
        </StackPanel>

        <ScrollViewer Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Stretch" Padding="0,0,6,0">

                <Border Style="{StaticResource CommandHeaderBorderStyle}" Translation="0,0,32">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooAccentBrush}" />
                        <StackPanel Grid.Column="1" Spacing="7">
                            <TextBlock Text="Startup &amp; Services" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource RooTextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.LoadSummary, Mode=OneWay}" FontSize="13" LineHeight="19"
                                       TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                            <TextBlock Text="What loads with Windows and what runs in the background — reviewed here before anything is paused."
                                       FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.BackgroundCount, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}"
                                       Foreground="{StaticResource RooTextPrimaryBrush}" />
                            <TextBlock Text="Background apps" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.LauncherCount, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}"
                                       Foreground="{StaticResource RiskLowBrush}" />
                            <TextBlock Text="Launchers &amp; helpers" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.ProtectedCount, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}"
                                       Foreground="{StaticResource RiskProtectedBrush}" />
                            <TextBlock Text="Protected" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="BACKGROUND LOAD" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        <ListView SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" Padding="0"
                                  ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                                  ItemsSource="{x:Bind ViewModel.BackgroundRows}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:BackgroundRow">
                                    <Grid ColumnSpacing="14" Padding="0,9" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource RooTextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Role}" FontSize="12" Foreground="{StaticResource RooTextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Ram}" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind StateText}" FontSize="12" FontWeight="Medium"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="These don't need to load with Windows. Pausing and startup trimming ship with the same preview-and-restore gates as Process Control — nothing is changed from this page today."
                                   FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="STARTUP REVIEW" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        <TextBlock Text="Startup entries are read with Autoruns-class tooling, shown here for review first. You approve every change, and every change is reversible."
                                   FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
