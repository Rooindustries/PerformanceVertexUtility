<Page
    x:Class="Roo.OptimizationSuite.Views.ToolsDiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Roo.OptimizationSuite.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="{StaticResource RooPageMargin}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Reading the tool review" Foreground="{StaticResource RooTextMutedBrush}" />
        </StackPanel>

        <ScrollViewer Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Stretch" Padding="0,0,6,0">

                <Border Style="{StaticResource CommandHeaderBorderStyle}" Translation="0,0,32">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooAccentBrush}" />
                        <StackPanel Grid.Column="1" Spacing="7">
                            <TextBlock Text="Tools &amp; Diagnostics" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource RooTextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.BundleSummary, Mode=OneWay}" FontSize="13" LineHeight="19"
                                       TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                            <TextBlock Text="Every bundled utility, classified: what Roo replaces natively, what's read-only, and what stays manual."
                                       FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.ToolCount, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}"
                                       Foreground="{StaticResource RooTextPrimaryBrush}" />
                            <TextBlock Text="Tools reviewed" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.NativeCount, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}"
                                       Foreground="{StaticResource RiskSafeBrush}" />
                            <TextBlock Text="Roo does natively" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.ManualCount, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}"
                                       Foreground="{StaticResource RiskProtectedBrush}" />
                            <TextBlock Text="Manual only" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="BUNDLED TOOLS" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        <ListView SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" Padding="0"
                                  ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                                  ItemsSource="{x:Bind ViewModel.ToolRows}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ToolRow">
                                    <Grid ColumnSpacing="14" Padding="0,9" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource RooTextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Plan}" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                                       Foreground="{StaticResource RooTextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ClassText}" FontSize="12" FontWeight="Medium"
                                                   TextAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="Nothing here launches anything. Dangerous and excluded tools stay manual, outside the optimizer, by design."
                                   FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
