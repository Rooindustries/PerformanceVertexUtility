<Page
    x:Class="Roo.OptimizationSuite.Views.PerformanceProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Roo.OptimizationSuite.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <DataTemplate x:Key="GtRowTemplate" x:DataType="vm:GameAppRow">
            <Grid Padding="14,11" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" VerticalAlignment="Center"
                            Background="{x:Bind PlanState, Converter={StaticResource RiskToBrush}}" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                   Foreground="{StaticResource RooTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind PlanWithRam}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{x:Bind PlanState, Converter={StaticResource RiskToBrush}}" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind Role}" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource RooTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{x:Bind Priority}" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource RooTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource RooPageMargin}">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Reading your processes" Foreground="{StaticResource RooTextMutedBrush}" />
        </StackPanel>

        <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{StaticResource CardBorderStyle}"
                Background="{StaticResource RooSurfaceCardBrush}" BorderBrush="{StaticResource RooBorderBrush}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
            <StackPanel Spacing="8">
                <TextBlock Text="Can't read your processes yet" Style="{StaticResource SectionHeaderTextBlockStyle}"
                           Foreground="{StaticResource RooTextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{StaticResource RooTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="ProcessScroller" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ProcessContent" Spacing="18" HorizontalAlignment="Center" MaxWidth="1320">

                <Border Style="{StaticResource CommandHeaderBorderStyle}" Translation="0,0,32">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooAccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="Game Tune" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource RooTextPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind ViewModel.GameStatusLevel, Mode=OneWay, Converter={StaticResource RiskToBrush}}" />
                                        <TextBlock Text="{x:Bind ViewModel.GameStatus, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.RuleSummary, Mode=OneWay}" FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                           Foreground="{StaticResource RooTextMutedBrush}" MaxWidth="640" />
                            </StackPanel>
                        </Grid>
                        <Border CornerRadius="8" BorderThickness="1" Padding="14"
                                Background="{StaticResource RooSurfaceInputBrush}" BorderBrush="{StaticResource RooBorderBrush}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.ActionTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource RooTextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ActionDetail, Mode=OneWay}" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                               Foreground="{StaticResource RooTextMutedBrush}" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{x:Bind ViewModel.PreviewPlanCommand}" Padding="12,8"
                                            AutomationProperties.Name="Check"
                                            IsEnabled="{x:Bind ViewModel.CanRunProcessAction, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                            <TextBlock Text="Check" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.ApplyProfileCommand}" Padding="12,8"
                                            AutomationProperties.Name="Apply"
                                            IsEnabled="{x:Bind ViewModel.CanRunProcessAction, Mode=OneWay}"
                                            Background="{StaticResource RooNavCtaBrush}" Foreground="{StaticResource RooOnCtaBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{StaticResource RooOnCtaBrush}" />
                                            <TextBlock Text="Apply" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Command="{x:Bind ViewModel.RestoreProfileCommand}" Padding="12,8"
                                            AutomationProperties.Name="Restore"
                                            IsEnabled="{x:Bind ViewModel.CanRestoreProfile, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE777;" FontSize="14" />
                                            <TextBlock Text="Restore" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.ActionBusy, Mode=OneWay}" Width="18" Height="18" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RestoreHint, Mode=OneWay}" FontSize="11" LineHeight="16"
                                               Foreground="{StaticResource RooTextMutedBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" BorderThickness="1" Padding="14"
                                    Background="{StaticResource RooSurfaceInputBrush}" BorderBrush="{StaticResource RooBorderBrush}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Game priority" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource RooTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.MatchTuneStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource RooAccentBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.MatchTuneDetail, Mode=OneWay}" FontSize="12" LineHeight="17"
                                                   TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{x:Bind ViewModel.CheckMatchTuneCommand}" Padding="10,8"
                                                AutomationProperties.Name="Check game priority"
                                                IsEnabled="{x:Bind ViewModel.CanCheckMatchTune, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE9D9;" FontSize="13" />
                                                <TextBlock Text="Check" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Command="{x:Bind ViewModel.StartMatchTuneCommand}" Padding="10,8"
                                                AutomationProperties.Name="Start game priority"
                                                IsEnabled="{x:Bind ViewModel.CanStartMatchTune, Mode=OneWay}"
                                                Background="{StaticResource RooNavCtaBrush}" Foreground="{StaticResource RooOnCtaBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="{StaticResource RooOnCtaBrush}" />
                                                <TextBlock Text="Start" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Command="{x:Bind ViewModel.RestoreMatchTuneCommand}" Padding="10,8"
                                                AutomationProperties.Name="Restore game priority"
                                                IsEnabled="{x:Bind ViewModel.CanRestoreMatchTune, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE777;" FontSize="13" />
                                                <TextBlock Text="Restore" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="8" BorderThickness="1" Padding="14"
                                    Background="{StaticResource RooSurfaceInputBrush}" BorderBrush="{StaticResource RooBorderBrush}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="ProBalance guard" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource RooTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.GovernorStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource RooAccentBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.GovernorDetail, Mode=OneWay}" FontSize="12" LineHeight="17"
                                                   TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{x:Bind ViewModel.CheckGovernorCommand}" Padding="10,8"
                                                AutomationProperties.Name="Check ProBalance guard"
                                                IsEnabled="{x:Bind ViewModel.CanCheckGovernor, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE9D9;" FontSize="13" />
                                                <TextBlock Text="Check" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Command="{x:Bind ViewModel.StartGovernorCommand}" Padding="10,8"
                                                AutomationProperties.Name="Start ProBalance guard"
                                                IsEnabled="{x:Bind ViewModel.CanStartGovernor, Mode=OneWay}"
                                                Background="{StaticResource RooNavCtaBrush}" Foreground="{StaticResource RooOnCtaBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="{StaticResource RooOnCtaBrush}" />
                                                <TextBlock Text="Start" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Command="{x:Bind ViewModel.RestoreGovernorCommand}" Padding="10,8"
                                                AutomationProperties.Name="Restore ProBalance guard"
                                                IsEnabled="{x:Bind ViewModel.CanRestoreGovernor, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE777;" FontSize="13" />
                                                <TextBlock Text="Restore" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16" Padding="0">
                    <StackPanel>
                        <StackPanel Padding="18,16" Spacing="12">
                            <TextBlock FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}">
                                <Run Text="{x:Bind ViewModel.AppsCount, Mode=OneWay}" /><Run Text=" apps" />
                                <Run Text="  /  " /><Run Text="{x:Bind ViewModel.KeepCount, Mode=OneWay}" /><Run Text=" kept steady" />
                                <Run Text="  /  " /><Run Text="{x:Bind ViewModel.QuietCount, Mode=OneWay}" /><Run Text=" can quiet down" />
                            </TextBlock>
                            <TextBox PlaceholderText="Search apps" HorizontalAlignment="Stretch"
                                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Grid Padding="14,10" ColumnSpacing="12" Background="{StaticResource RooSurfaceElevatedBrush}"
                              BorderThickness="0,1,0,1" BorderBrush="{StaticResource RooBorderBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="App" Margin="13,0,0,0" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="Role" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="Priority" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows}" ItemTemplate="{StaticResource GtRowTemplate}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
