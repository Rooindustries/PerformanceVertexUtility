<Page
    x:Class="Roo.OptimizationSuite.Views.PerformanceProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Roo.OptimizationSuite.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <DataTemplate x:Key="GtRowTemplate" x:DataType="vm:GameAppRow">
            <Grid Padding="14,11" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" VerticalAlignment="Center"
                            Background="{x:Bind PlanState, Converter={StaticResource RiskToBrush}}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource RooTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind Role}" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource RooTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{x:Bind Priority}" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource RooTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{x:Bind Ram}" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RooTextDisplayBrush}" />
                <TextBlock Grid.Column="4" Text="{x:Bind Plan}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{x:Bind PlanState, Converter={StaticResource RiskToBrush}}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource RooPageMargin}">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Reading your processes" Foreground="{StaticResource RooTextMutedBrush}" />
        </StackPanel>

        <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{StaticResource CardBorderStyle}"
                Background="{StaticResource RooSurfaceCardBrush}" BorderBrush="{StaticResource RooBorderBrush}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
            <StackPanel Spacing="8">
                <TextBlock Text="Can't read your processes yet" Style="{StaticResource SectionHeaderTextBlockStyle}"
                           Foreground="{StaticResource RooTextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{StaticResource RooTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18" HorizontalAlignment="Stretch" Padding="0,0,6,0">

                <Border Style="{StaticResource CommandHeaderBorderStyle}" Translation="0,0,32">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooAccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="Game Tune" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource RooTextPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind ViewModel.GameStatusLevel, Mode=OneWay, Converter={StaticResource RiskToBrush}}" />
                                        <TextBlock Text="{x:Bind ViewModel.GameStatus, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.RuleSummary, Mode=OneWay}" FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                           Foreground="{StaticResource RooTextMutedBrush}" MaxWidth="640" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <Button Click="OnPrimaryActionClick" IsEnabled="{x:Bind ViewModel.PrimaryActionEnabled, Mode=OneWay}"
                                    HorizontalAlignment="Right" Style="{StaticResource NavCtaButtonStyle}"
                                    Background="{StaticResource RooNavCtaBrush}" Foreground="{StaticResource RooOnCtaBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{StaticResource RooOnCtaBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.PrimaryActionLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{x:Bind ViewModel.SessionSummary, Mode=OneWay}" FontSize="11" LineHeight="16"
                                       TextWrapping="Wrap" MaxWidth="240" TextAlignment="Right"
                                       Foreground="{StaticResource RooTextMutedBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.AppsCount, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" Foreground="{StaticResource RooTextPrimaryBrush}" />
                            <TextBlock Text="Apps" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.KeepCount, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" Foreground="{StaticResource RiskProtectedBrush}" />
                            <TextBlock Text="Kept safe" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.QuietCount, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" Foreground="{StaticResource RiskLowBrush}" />
                            <TextBlock Text="Quieted" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBox PlaceholderText="Search apps" HorizontalAlignment="Stretch"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Border Style="{StaticResource FocalPanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="BOOST — THE GAME" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RiskSafeBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.BoostRows}" ItemTemplate="{StaticResource GtRowTemplate}" />
                        <TextBlock Text="Foreground game boost for frame-time stability while OBS and Discord run."
                                   FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="PROTECTED — STAYS UNTOUCHED" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RiskProtectedBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ProtectedRows}" ItemTemplate="{StaticResource GtRowTemplate}" />
                        <TextBlock Text="OBS, Discord, and system safeguards stay protected — stream encode and capture are part of the session."
                                   FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="QUIET — PUSHED DOWN FOR THE MATCH" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RiskLowBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.QuietRows}" ItemTemplate="{StaticResource GtRowTemplate}" />
                        <TextBlock Text="Launchers and browser helpers should not compete with the game, OBS, or Discord once the match is running."
                                   FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="Keep quieting background apps during the match" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{StaticResource RooTextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.GovernorCaption, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.KeepQuietingDuringMatch, Mode=TwoWay}" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
