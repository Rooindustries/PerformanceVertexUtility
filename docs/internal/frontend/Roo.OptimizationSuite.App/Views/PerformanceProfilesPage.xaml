<Page
    x:Class="Roo.OptimizationSuite.Views.PerformanceProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Roo.OptimizationSuite.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <DataTemplate x:Key="ProcessCapabilityItemTemplate" x:DataType="vm:ProcessCapabilityItem">
            <StackPanel Padding="10,5,10,7" Spacing="0">
                <ContentControl Content="{x:Bind Row}"
                                ContentTemplate="{StaticResource CapabilityRowTemplate}"
                                HorizontalContentAlignment="Stretch" />
                <TextBlock Text="{x:Bind MetaText}"
                           Margin="17,-2,0,0"
                           FontSize="11"
                           LineHeight="16"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource RooTextMutedBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ProcessGateTemplate" x:DataType="vm:ProcessCapabilityGateLine">
            <Grid Padding="0,5" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0"
                         Width="7"
                         Height="7"
                         Margin="0,5,0,0"
                         VerticalAlignment="Top"
                         Fill="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind Label}"
                           FontSize="12"
                           LineHeight="17"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource RooTextSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProcessRowTemplate" x:DataType="vm:GameAppRow">
            <Grid Padding="12,9" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="3"
                            Height="16"
                            CornerRadius="1.5"
                            VerticalAlignment="Center"
                            Background="{x:Bind PlanState, Converter={StaticResource RiskToBrush}}" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Name}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource RooTextPrimaryBrush}" />
                </Grid>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind Role}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource RooTextSecondaryBrush}" />
                <TextBlock Grid.Column="2"
                           Text="{x:Bind Priority}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource RooTextSecondaryBrush}" />
                <TextBlock Grid.Column="3"
                           Text="{x:Bind Ram}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource RooTextDisplayBrush}" />
                <TextBlock Grid.Column="4"
                           Text="{x:Bind Plan}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           LineHeight="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{x:Bind PlanState, Converter={StaticResource RiskToBrush}}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource RooPageMargin}">

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Reading process controls" Foreground="{StaticResource RooTextMutedBrush}" />
        </StackPanel>

        <Border MaxWidth="520"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Style="{StaticResource PanelBorderStyle}"
                Translation="0,0,16"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
            <StackPanel Spacing="8">
                <TextBlock Text="Can't read process controls"
                           Style="{StaticResource SectionHeaderTextBlockStyle}"
                           Foreground="{StaticResource RooTextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource RooTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18" HorizontalAlignment="Stretch" Padding="0,0,6,0">

                <Border Style="{StaticResource CommandHeaderBorderStyle}" Translation="0,0,32">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooAccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Process Controls"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource RooTextPrimaryBrush}" />
                                    <Grid Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0"
                                                 Width="8"
                                                 Height="8"
                                                 VerticalAlignment="Center"
                                                 Fill="{x:Bind ViewModel.ForegroundStatusLevel, Mode=OneWay, Converter={StaticResource RiskToBrush}}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ViewModel.ForegroundStatus, Mode=OneWay}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource RooTextSecondaryBrush}" />
                                    </Grid>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.RuleSummary, Mode=OneWay}"
                                           FontSize="13"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource RooTextMutedBrush}"
                                           MaxWidth="720" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" MaxWidth="260">
                            <TextBlock Text="{x:Bind ViewModel.SessionSummary, Mode=OneWay}"
                                       FontSize="12"
                                       LineHeight="17"
                                       TextWrapping="Wrap"
                                       TextAlignment="Right"
                                       Foreground="{StaticResource RooTextMutedBrush}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FocalPanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="CAPABILITIES"
                                           Style="{StaticResource PanelLabelTextBlockStyle}"
                                           Foreground="{StaticResource RooTextMutedBrush}" />
                                <TextBlock Text="Process control capability rows come from the registry and explain route. Select a row to read gates and next step."
                                           FontSize="13"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource RooTextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" MinWidth="82">
                                <TextBlock Text="{x:Bind ViewModel.CapabilityCount, Mode=OneWay}"
                                           Style="{StaticResource MetricValueTextBlockStyle}"
                                           Foreground="{StaticResource RooTextPrimaryBrush}" />
                                <TextBlock Text="Rows"
                                           Style="{StaticResource MetricLabelTextBlockStyle}"
                                           Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4" MinWidth="100">
                                <TextBlock Text="{x:Bind ViewModel.AvailableCapabilityCount, Mode=OneWay}"
                                           Style="{StaticResource MetricValueTextBlockStyle}"
                                           Foreground="{StaticResource RiskSafeBrush}" />
                                <TextBlock Text="Available"
                                           Style="{StaticResource MetricLabelTextBlockStyle}"
                                           Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="18" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.18*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <ListView Grid.Column="0"
                                      ItemsSource="{x:Bind ViewModel.Capabilities}"
                                      SelectionMode="Single"
                                      SelectionChanged="OnCapabilitySelectionChanged"
                                      ItemTemplate="{StaticResource ProcessCapabilityItemTemplate}"
                                      Background="Transparent"
                                      Padding="0"
                                      MaxHeight="560" />

                            <StackPanel Grid.Column="1" Spacing="12">
                                <StackPanel Spacing="8"
                                            Visibility="{x:Bind ViewModel.HasSelectedCapability, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="Select a capability"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource RooTextPrimaryBrush}" />
                                    <TextBlock Text="The selected row shows its family, availability, apply status, approval, restore status, exact registry reason, router next step, and gates."
                                               FontSize="13"
                                               LineHeight="19"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource RooTextMutedBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="12"
                                            Visibility="{x:Bind ViewModel.HasSelectedCapability, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0"
                                                 Width="8"
                                                 Height="8"
                                                 Margin="0,7,0,0"
                                                 VerticalAlignment="Top"
                                                 Fill="{x:Bind ViewModel.SelectedCapabilityDotState, Mode=OneWay, Converter={StaticResource RiskToBrush}}" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedCapabilityLabel, Mode=OneWay}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource RooTextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedCapabilityFamily, Mode=OneWay}"
                                                       FontSize="12"
                                                       LineHeight="17"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource RooTextMutedBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="14" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.55*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Availability" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SelectedCapabilityAvailability, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Apply" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedCapabilityApply, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Approval" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedCapabilityApproval, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Restore" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedCapabilityRestore, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Registry reason" Style="{StaticResource MetricLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.SelectedCapabilityReason, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                    </Grid>

                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ProgressRing IsActive="{x:Bind ViewModel.ExplainBusy, Mode=OneWay}"
                                                          Width="16"
                                                          Height="16"
                                                          VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedCapabilityStatus, Mode=OneWay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource RooTextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCapabilityNextStep, Mode=OneWay}"
                                                   FontSize="13"
                                                   LineHeight="19"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource RooTextSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="GATES"
                                                   Style="{StaticResource PanelLabelTextBlockStyle}"
                                                   Foreground="{StaticResource RooTextMutedBrush}" />
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedGateRows}"
                                                       ItemTemplate="{StaticResource ProcessGateTemplate}" />
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind ViewModel.SelectedCapabilityErrors, Mode=OneWay}"
                                               FontSize="12"
                                               LineHeight="17"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource RiskHighBrush}"
                                               Visibility="{x:Bind ViewModel.SelectedCapabilityErrors, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.AppsCount, Mode=OneWay}"
                                       Style="{StaticResource MetricValueTextBlockStyle}"
                                       Foreground="{StaticResource RooTextPrimaryBrush}" />
                            <TextBlock Text="Processes"
                                       Style="{StaticResource MetricLabelTextBlockStyle}"
                                       Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.KeepCount, Mode=OneWay}"
                                       Style="{StaticResource MetricValueTextBlockStyle}"
                                       Foreground="{StaticResource RiskProtectedBrush}" />
                            <TextBlock Text="Protected"
                                       Style="{StaticResource MetricLabelTextBlockStyle}"
                                       Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.CandidateCount, Mode=OneWay}"
                                       Style="{StaticResource MetricValueTextBlockStyle}"
                                       Foreground="{StaticResource RiskLowBrush}" />
                            <TextBlock Text="Candidates"
                                       Style="{StaticResource MetricLabelTextBlockStyle}"
                                       Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="PROCESS CONTEXT"
                                   Style="{StaticResource PanelLabelTextBlockStyle}"
                                   Foreground="{StaticResource RooTextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ProcessContextMessage, Mode=OneWay}"
                                   FontSize="13"
                                   LineHeight="19"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource RooTextMutedBrush}"
                                   Visibility="{x:Bind ViewModel.ProcessContextMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                        <TextBox PlaceholderText="Search processes"
                                 HorizontalAlignment="Stretch"
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="FOREGROUND TARGET"
                                   Style="{StaticResource PanelLabelTextBlockStyle}"
                                   Foreground="{StaticResource RiskSafeBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ForegroundRows}"
                                       ItemTemplate="{StaticResource ProcessRowTemplate}" />
                        <TextBlock Text="Foreground processes are shown as candidates for priority and affinity routes. Changes require capability approval."
                                   FontSize="12"
                                   LineHeight="17"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource RooTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="PROTECTED COMPANIONS"
                                   Style="{StaticResource PanelLabelTextBlockStyle}"
                                   Foreground="{StaticResource RiskProtectedBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ProtectedRows}"
                                       ItemTemplate="{StaticResource ProcessRowTemplate}" />
                        <TextBlock Text="OBS, Discord, and protected dependencies stay grouped inside process context so capture and voice are not treated as cleanup targets."
                                   FontSize="12"
                                   LineHeight="17"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource RooTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="DEMOTION CANDIDATES"
                                   Style="{StaticResource PanelLabelTextBlockStyle}"
                                   Foreground="{StaticResource RiskLowBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.CandidateRows}"
                                       ItemTemplate="{StaticResource ProcessRowTemplate}" />
                        <TextBlock Text="Launchers, browser helpers, and vendor utilities are only listed as candidates here; the route controls whether anything can apply."
                                   FontSize="12"
                                   LineHeight="17"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource RooTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="GOVERNOR BUDGET"
                                   Style="{StaticResource PanelLabelTextBlockStyle}"
                                   Foreground="{StaticResource RooTextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.GovernorCaption, Mode=OneWay}"
                                   FontSize="13"
                                   LineHeight="19"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource RooTextSecondaryBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
