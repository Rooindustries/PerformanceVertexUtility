<Page
    x:Class="Roo.OptimizationSuite.Views.DriversProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <Style x:Key="StretchListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource RooPageMargin}">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Reading driver capabilities" Foreground="{StaticResource RooTextMutedBrush}" />
        </StackPanel>

        <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{StaticResource PanelBorderStyle}" Translation="0,0,16"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
            <StackPanel Spacing="8">
                <TextBlock Text="Can't read driver capabilities yet" Style="{StaticResource SectionHeaderTextBlockStyle}"
                           Foreground="{StaticResource RooTextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{StaticResource RooTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18" HorizontalAlignment="Stretch" Padding="0,0,6,0">

                <Border Style="{StaticResource CommandHeaderBorderStyle}" Translation="0,0,32">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooAccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Text="Drivers &amp; NVIDIA" FontSize="22" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Foreground="{StaticResource RooTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="13" LineHeight="19"
                                           TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" MaxWidth="500" />
                            </StackPanel>
                        </Grid>
                        <Button Grid.Column="1" VerticalAlignment="Center" Click="OnRefreshClick"
                                Style="{StaticResource NavCtaButtonStyle}"
                                Background="{StaticResource RooNavCtaBrush}" Foreground="{StaticResource RooOnCtaBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="15" Foreground="{StaticResource RooOnCtaBrush}" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="18" RowSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16" Padding="0">
                        <StackPanel>
                            <StackPanel Padding="20,16,20,8" Spacing="5">
                                <TextBlock Text="CAPABILITIES" Style="{StaticResource PanelLabelTextBlockStyle}"
                                           Foreground="{StaticResource RooTextMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CapabilityCountLine, Mode=OneWay}" FontSize="13"
                                           TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                            </StackPanel>
                            <ListView ItemsSource="{x:Bind ViewModel.Capabilities}" SelectionMode="Single"
                                      SelectedItem="{x:Bind ViewModel.SelectedCapability, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource CapabilityRowTemplate}"
                                      ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                                      Background="Transparent" Padding="14,0,14,14" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="CAPABILITY DETAIL" Style="{StaticResource PanelLabelTextBlockStyle}"
                                               Foreground="{StaticResource RooTextMutedBrush}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{x:Bind ViewModel.SelectedCapabilityState, Mode=OneWay, Converter={StaticResource RiskToBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedCapabilityLabel, Mode=OneWay}" FontSize="18"
                                                   LineHeight="24" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{StaticResource RooTextPrimaryBrush}" />
                                    </Grid>
                                <TextBlock Text="{x:Bind ViewModel.SelectedCapabilityId, Mode=OneWay}" FontSize="11"
                                           LineHeight="16" TextWrapping="Wrap" FontFamily="Consolas, monospace"
                                           Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19">
                                    <Run Text="Family/page: " FontWeight="SemiBold" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                    <Run Text="{x:Bind ViewModel.SelectedFamilyPage, Mode=OneWay}" Foreground="{StaticResource RooTextMutedBrush}" />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19">
                                    <Run Text="Machine availability: " FontWeight="SemiBold" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                    <Run Text="{x:Bind ViewModel.SelectedMachineAvailability, Mode=OneWay}" Foreground="{StaticResource RooTextMutedBrush}" />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19">
                                    <Run Text="Apply status: " FontWeight="SemiBold" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                    <Run Text="{x:Bind ViewModel.SelectedApplyStatus, Mode=OneWay}" Foreground="{StaticResource RooTextMutedBrush}" />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19">
                                    <Run Text="Approval: " FontWeight="SemiBold" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                    <Run Text="{x:Bind ViewModel.SelectedApproval, Mode=OneWay}" Foreground="{StaticResource RooTextMutedBrush}" />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19">
                                    <Run Text="Rollback: " FontWeight="SemiBold" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                    <Run Text="{x:Bind ViewModel.SelectedRestore, Mode=OneWay}" Foreground="{StaticResource RooTextMutedBrush}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Spacing="7"
                                        Visibility="{x:Bind ViewModel.SelectedReasonOrNextStep, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="REASON OR NEXT STEP" Style="{StaticResource PanelLabelTextBlockStyle}"
                                           Foreground="{StaticResource RooTextMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedReasonOrNextStep, Mode=OneWay}" FontSize="13"
                                           LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing Grid.Column="0"
                                                  IsActive="{x:Bind ViewModel.IsExplaining, Mode=OneWay}"
                                                  Width="18" Height="18"
                                                  Visibility="{x:Bind ViewModel.IsExplaining, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.SelectedExplainStatus, Mode=OneWay}" FontSize="12"
                                               LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRouterNextStep, Mode=OneWay}" FontSize="13"
                                           LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}"
                                           Visibility="{x:Bind ViewModel.SelectedRouterNextStep, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedGates, Mode=OneWay}" FontSize="12"
                                           LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}"
                                           Visibility="{x:Bind ViewModel.SelectedGates, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedErrors, Mode=OneWay}" FontSize="12"
                                           LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RiskProtectedBrush}"
                                           Visibility="{x:Bind ViewModel.SelectedErrors, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16"
                        Visibility="{x:Bind ViewModel.HasHardwareSummary, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="THIS PC" Style="{StaticResource PanelLabelTextBlockStyle}"
                                   Foreground="{StaticResource RooTextMutedBrush}" />
                        <Grid ColumnSpacing="16" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.45*" />
                                <ColumnDefinition Width="1.55*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="System" Style="{StaticResource MetricLabelTextBlockStyle}"
                                       Foreground="{StaticResource RooTextMutedBrush}" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.MachineModel, Mode=OneWay}" FontSize="15" LineHeight="21"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource RooTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.MachineOsCaption, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Processor" Style="{StaticResource MetricLabelTextBlockStyle}"
                                       Foreground="{StaticResource RooTextMutedBrush}" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.CpuName, Mode=OneWay}" FontSize="15" LineHeight="21"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource RooTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CpuCoreSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Graphics" Style="{StaticResource MetricLabelTextBlockStyle}"
                                       Foreground="{StaticResource RooTextMutedBrush}" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.PrimaryGpuName, Mode=OneWay}" FontSize="15" LineHeight="21"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource RooTextDisplayBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.PrimaryGpuDriverSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
