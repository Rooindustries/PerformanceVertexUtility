<Page
    x:Class="Roo.OptimizationSuite.Views.MonitoringPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Roo.OptimizationSuite.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <DataTemplate x:Key="LiveTileTemplate" x:DataType="vm:MetricTile">
            <StackPanel Spacing="6" Padding="0,0,18,0">
                <TextBlock Text="{x:Bind Value}" FontSize="22" FontWeight="SemiBold" LineHeight="26" Foreground="{StaticResource RooTextPrimaryBrush}" />
                <TextBlock Text="{x:Bind Label}" FontSize="13" LineHeight="19" Foreground="{StaticResource RooTextSecondaryBrush}" />
                <TextBlock Text="{x:Bind Caption}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PendingTileTemplate" x:DataType="vm:MetricTile">
            <StackPanel Spacing="6" Padding="0,0,18,0">
                <TextBlock Text="{x:Bind Value}" FontSize="16" FontWeight="SemiBold" LineHeight="22" Foreground="{StaticResource RooTextMutedBrush}" />
                <TextBlock Text="{x:Bind Label}" FontSize="13" LineHeight="19" Foreground="{StaticResource RooTextSecondaryBrush}" />
                <TextBlock Text="{x:Bind Caption}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StutterToolTemplate" x:DataType="vm:StutterToolRow">
            <Grid Padding="0,11" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" LineHeight="20"
                               TextWrapping="Wrap" Foreground="{StaticResource RooTextPrimaryBrush}" />
                    <TextBlock Text="{x:Bind Why}" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                               Foreground="{StaticResource RooTextMutedBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                        <TextBlock Text="{x:Bind StateLine}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                        <TextBlock Text="{x:Bind Caption}" FontSize="12" Foreground="{StaticResource RooTextMutedBrush}"
                                   Visibility="{x:Bind Caption, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Content="{x:Bind ActionLabel}" IsEnabled="False" Padding="14,6" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SensorTemplate" x:DataType="vm:StatusLine">
            <Grid Padding="0,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource RooTextSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind State, Converter={StaticResource RiskToBrush}}" />
                    <TextBlock Text="{x:Bind Value}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RooTextPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource RooPageMargin}">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Reading this PC" Foreground="{StaticResource RooTextMutedBrush}" />
        </StackPanel>

        <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{StaticResource PanelBorderStyle}" Translation="0,0,16"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
            <StackPanel Spacing="8">
                <TextBlock Text="Can't read this PC yet" Style="{StaticResource SectionHeaderTextBlockStyle}" Foreground="{StaticResource RooTextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18" HorizontalAlignment="Stretch" Padding="0,0,6,0">

                <Border Style="{StaticResource CommandHeaderBorderStyle}" Translation="0,0,32">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooAccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Text="Live Feel" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource RooTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                        <Button Grid.Column="1" VerticalAlignment="Center" Click="OnReadFramePacingClick"
                                Style="{StaticResource NavCtaButtonStyle}"
                                Background="{StaticResource RooNavCtaBrush}" Foreground="{StaticResource RooOnCtaBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D2;" FontSize="15" Foreground="{StaticResource RooOnCtaBrush}" />
                                <TextBlock Text="Read Frame Pacing" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="RIGHT NOW" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.LiveTiles}" ItemTemplate="{StaticResource LiveTileTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="160" MinColumnSpacing="8" MinRowSpacing="16" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="FRAME PACING" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.PendingTiles}" ItemTemplate="{StaticResource PendingTileTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="160" MinColumnSpacing="8" MinRowSpacing="16" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind ViewModel.IsSampleCapture, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource RiskNeutralBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SampleCaptureLine, Mode=OneWay}" FontSize="12" LineHeight="17"
                                       TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="STUTTER TOOLS" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.StutterTools}" ItemTemplate="{StaticResource StutterToolTemplate}" />
                        <TextBlock Text="{x:Bind ViewModel.StutterFooterLine, Mode=OneWay}" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                   Foreground="{StaticResource RooTextMutedBrush}"
                                   Visibility="{x:Bind ViewModel.StutterFooterLine, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16" MaxWidth="560" HorizontalAlignment="Left">
                    <StackPanel Spacing="10">
                        <TextBlock Text="SENSORS" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sensors}" ItemTemplate="{StaticResource SensorTemplate}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
