<Page
    x:Class="Roo.OptimizationSuite.Views.UninstallCleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Roo.OptimizationSuite.Models"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <DataTemplate x:Key="AppItemTemplate" x:DataType="models:InstalledApp">
            <StackPanel Padding="4,11" Spacing="3">
                <TextBlock Text="{x:Bind FriendlyName}" FontWeight="SemiBold" FontSize="14" LineHeight="20"
                           Foreground="{StaticResource RooTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind SecondaryLabel}" FontSize="11" LineHeight="16"
                               VerticalAlignment="Center" Foreground="{StaticResource RooTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{x:Bind EstimatedSizeBytes, Converter={StaticResource BytesToReadable}}" FontSize="12" LineHeight="17"
                               VerticalAlignment="Center" Foreground="{StaticResource RooTextDisplayBrush}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="LeftoverTemplate" x:DataType="models:LeftoverItem">
            <Grid Padding="0,9" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind Type}" FontSize="11" VerticalAlignment="Center" Width="78"
                           Foreground="{StaticResource RooTextMutedBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Target}" FontSize="12" VerticalAlignment="Center"
                           FontFamily="Consolas, monospace" Foreground="{StaticResource RooTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{x:Bind Confidence}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource RooTextMutedBrush}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="CleanupRoot" Padding="{StaticResource RooPageMargin}">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Reading your installed apps" Foreground="{StaticResource RooTextMutedBrush}" />
        </StackPanel>

        <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{StaticResource PanelBorderStyle}" Translation="0,0,16"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
            <StackPanel Spacing="8">
                <TextBlock Text="Can't read installed apps yet" Style="{StaticResource SectionHeaderTextBlockStyle}"
                           Foreground="{StaticResource RooTextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{StaticResource RooTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Grid x:Name="CleanupContent" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" RowSpacing="18"
              HorizontalAlignment="Center" MaxWidth="1320">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CommandHeaderBorderStyle}" Translation="0,0,32">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooAccentBrush}" />
                        <StackPanel Grid.Column="1" Spacing="7">
                            <TextBlock Text="Apps &amp; Cleanup" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource RooTextPrimaryBrush}" />
                            <TextBlock Text="Pick an app. Roo Industries checks the path, scans leftovers, and builds the cleanup run." FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                            <TextBlock FontSize="12" LineHeight="17" Foreground="{StaticResource RooTextMutedBrush}">
                                <Run Text="{x:Bind ViewModel.AppCount, Mode=OneWay}" /><Run Text=" apps installed" />
                                <Run Text="  /  Nothing is removed until you approve it." />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1" x:Name="MasterDetail" ColumnSpacing="18" RowSpacing="16" SizeChanged="MasterDetail_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="1*" />
                    <ColumnDefinition x:Name="DetailColumn" Width="1.05*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TopRow" Height="*" />
                    <RowDefinition x:Name="DetailRow" Height="0" />
                </Grid.RowDefinitions>

                <Grid x:Name="ListPane" Grid.Row="0" Grid.Column="0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" PlaceholderText="Search installed apps"
                             AutomationProperties.AutomationId="AppsCleanupSearchBox"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16" Padding="0">
                        <StackPanel>
                            <TextBlock Text="INSTALLED APPS" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" Padding="20,16,20,8" />
                            <ListView x:Name="AppsList" ItemsSource="{x:Bind ViewModel.Apps}" SelectionMode="Single"
                                      AutomationProperties.AutomationId="AppsCleanupInstalledAppsList"
                                      IsItemClickEnabled="True" ItemClick="AppsList_ItemClick"
                                      SelectedItem="{x:Bind ViewModel.SelectedApp, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource AppItemTemplate}"
                                      Background="Transparent" Padding="6,0,6,6" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="DetailPane" Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Translation="0,0,16" Padding="0">
                  <Grid>

                    <StackPanel VerticalAlignment="Top" Padding="24,18,24,28" Spacing="12"
                                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Spacing="5">
                            <TextBlock Text="APP REVIEW" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                            <TextBlock Text="Pick an app to review" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource RooTextPrimaryBrush}" />
                            <TextBlock Text="Select an app and Roo Industries will build the removal path. Nothing is removed until you approve it."
                                       FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="9">
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="18">
                                <Run Text="Path" FontWeight="SemiBold" Foreground="{StaticResource RooTextSecondaryBrush}" /><Run Text=" - Check the safest first step. Some apps expose a Windows removal path; Roo Industries still owns the plan." Foreground="{StaticResource RooTextMutedBrush}" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="18">
                                <Run Text="Scan" FontWeight="SemiBold" Foreground="{StaticResource RooTextSecondaryBrush}" /><Run Text=" - Find what the app leaves behind." Foreground="{StaticResource RooTextMutedBrush}" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="18">
                                <Run Text="Apply" FontWeight="SemiBold" Foreground="{StaticResource RooTextSecondaryBrush}" /><Run Text=" - Approve the exact list first. Restore appears after rollback data exists." Foreground="{StaticResource RooTextMutedBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0">
                        <StackPanel Padding="24,20,24,24" Spacing="20">

                            <StackPanel Spacing="7">
                                <TextBlock Text="APP REVIEW" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource RooTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedSummary, Mode=OneWay}" FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                           Foreground="{StaticResource RooTextSecondaryBrush}" />
                            </StackPanel>

                            <Border CornerRadius="8" Background="{StaticResource RooSurfaceInputBrush}" BorderBrush="{StaticResource RooBorderBrush}" BorderThickness="1" Padding="16,14">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Removal run" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource RooTextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.ApplyApprovalSummary, Mode=OneWay}" FontSize="12" LineHeight="17"
                                                       TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                                        </StackPanel>
                                        <ProgressRing Grid.Column="1" Width="20" Height="20" IsActive="{x:Bind ViewModel.ScanBusy, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" Content="{x:Bind ViewModel.PrimaryRemovalButtonLabel, Mode=OneWay}" Command="{x:Bind ViewModel.PreviewRemovalCommand}"
                                                AutomationProperties.AutomationId="AppsCleanupCheckRouteButton"
                                                AutomationProperties.Name="Check removal route"
                                                IsEnabled="{x:Bind ViewModel.CanReviewRemovalAction, Mode=OneWay}" HorizontalAlignment="Stretch" Padding="10,8" />
                                        <Button Grid.Row="0" Grid.Column="1" Content="Scan leftovers" Command="{x:Bind ViewModel.ScanLeftoversCommand}"
                                                AutomationProperties.AutomationId="AppsCleanupScanLeftoversButton"
                                                AutomationProperties.Name="Scan leftovers"
                                                IsEnabled="{x:Bind ViewModel.CanScanAction, Mode=OneWay}" HorizontalAlignment="Stretch" Padding="10,8" />
                                        <Button Grid.Row="0" Grid.Column="2" Content="Build list" Command="{x:Bind ViewModel.BuildCleanupListCommand}"
                                                AutomationProperties.AutomationId="AppsCleanupBuildListButton"
                                                AutomationProperties.Name="Build removal list"
                                                IsEnabled="{x:Bind ViewModel.CanBuildCleanupListAction, Mode=OneWay}" HorizontalAlignment="Stretch" Padding="10,8" />
                                        <Button Grid.Row="1" Grid.Column="0" Content="Run final check" Command="{x:Bind ViewModel.RunFinalCheckCommand}"
                                                AutomationProperties.AutomationId="AppsCleanupRunFinalCheckButton"
                                                AutomationProperties.Name="Run cleanup final check"
                                                IsEnabled="{x:Bind ViewModel.CanRunFinalCheckAction, Mode=OneWay}"
                                                HorizontalAlignment="Stretch" Padding="10,8" />
                                        <Button Grid.Row="1" Grid.Column="1" Content="Apply cleanup" Command="{x:Bind ViewModel.ApplyCleanupCommand}"
                                                AutomationProperties.AutomationId="AppsCleanupApplyReviewedRunButton"
                                                AutomationProperties.Name="Apply reviewed cleanup"
                                                IsEnabled="{x:Bind ViewModel.CanApplyCleanupAction, Mode=OneWay}"
                                                Background="{StaticResource RooNavCtaBrush}" Foreground="{StaticResource RooOnCtaBrush}" HorizontalAlignment="Stretch" Padding="10,8" />
                                        <Button Grid.Row="1" Grid.Column="2" Content="Restore from backup" Command="{x:Bind ViewModel.RestoreCleanupCommand}"
                                                AutomationProperties.AutomationId="AppsCleanupRestoreFromBackupButton"
                                                AutomationProperties.Name="Restore removal from backup"
                                                IsEnabled="{x:Bind ViewModel.CanRestoreCleanupAction, Mode=OneWay}" HorizontalAlignment="Stretch" Padding="10,8" />
                                    </Grid>

                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <CheckBox Grid.Column="0" Content="I reviewed the route and dependency risks"
                                                  AutomationProperties.AutomationId="AppsCleanupReviewedRouteCheckBox"
                                                  IsChecked="{x:Bind ViewModel.RemoverPathApproved, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind ViewModel.CleanupPlanReady, Mode=OneWay}"
                                                  Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        <CheckBox Grid.Column="1" Content="I reviewed the removal list"
                                                  AutomationProperties.AutomationId="AppsCleanupReviewedListCheckBox"
                                                  IsChecked="{x:Bind ViewModel.CleanupListApproved, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind ViewModel.CleanupPlanReady, Mode=OneWay}"
                                                  Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                  AutomationProperties.AutomationId="AppsCleanupFinalApplyCheckBox"
                                                  IsChecked="{x:Bind ViewModel.RealCleanupApproved, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind ViewModel.CleanupPlanReady, Mode=OneWay}"
                                                  Foreground="{StaticResource RooTextSecondaryBrush}">
                                            <TextBlock Text="I understand this removes the reviewed files from this PC"
                                                       TextWrapping="WrapWholeWords" />
                                        </CheckBox>
                                    </Grid>

                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RooTextAccentBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OfficialPreviewState, Mode=OneWay}" FontSize="12" LineHeight="17"
                                                       TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="2" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RooTextAccentBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LeftoverState, Mode=OneWay}" FontSize="12" LineHeight="17"
                                                       TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        </Grid>
                                        <Grid Grid.Row="2" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="3" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RooTextAccentBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RemovalPlanState, Mode=OneWay}" FontSize="12" LineHeight="17"
                                                       TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                        </Grid>
                                        <Grid Grid.Row="3" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="4" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RooTextAccentBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{x:Bind ViewModel.CleanupExecutionState, Mode=OneWay}" FontSize="12" LineHeight="17"
                                                           TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.CleanupExecutionDetail, Mode=OneWay}" FontSize="12" LineHeight="17"
                                                           TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}"
                                                           Visibility="{x:Bind ViewModel.CleanupExecutionDetail, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="12">
                                <TextBlock Text="{x:Bind ViewModel.RemovalPanelLabel, Mode=OneWay}" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.RemovalPathHeadline, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource RooTextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.RemovalPathHelp, Mode=OneWay}" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                               Foreground="{StaticResource RooTextMutedBrush}" />
                                </StackPanel>
                                <Border CornerRadius="8" Background="{StaticResource RooSurfaceInputBrush}" BorderBrush="{StaticResource RooBorderBrush}" BorderThickness="1" Padding="14,12">
                                    <TextBlock Text="{x:Bind ViewModel.OfficialCommand, Mode=OneWay}" FontSize="12" FontFamily="Consolas, monospace"
                                               TextWrapping="Wrap" MaxLines="4" LineHeight="19" LineStackingStrategy="BlockLineHeight"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                </Border>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Installed at" FontSize="11" LineHeight="16" Foreground="{StaticResource RooTextMutedBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.InstallLocation, Mode=OneWay}" FontSize="12" LineHeight="19" FontFamily="Consolas, monospace"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource RooTextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.OfficialPreviewState, Mode=OneWay}" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                           Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="LEFTOVER SCAN" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.LeftoverState, Mode=OneWay}" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                           Foreground="{StaticResource RooTextMutedBrush}"
                                           Visibility="{x:Bind ViewModel.LeftoverState, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                                <TextBlock Text="{x:Bind ViewModel.LeftoverSummary, Mode=OneWay}" FontSize="13" LineHeight="19" FontWeight="SemiBold"
                                           Foreground="{StaticResource RooTextDisplayBrush}"
                                           Visibility="{x:Bind ViewModel.LeftoverSummary, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Leftovers}" ItemTemplate="{StaticResource LeftoverTemplate}" />
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="REMOVAL PLAN" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                                <TextBlock Text="Roo Industries combines the app path, leftover scan, backup list, and restore plan into one review."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CleanupPlanState, Mode=OneWay}" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                           Foreground="{StaticResource RooTextMutedBrush}" />
                                <Border CornerRadius="8" Background="{StaticResource RooSurfaceInputBrush}" BorderBrush="{StaticResource RooBorderBrush}" BorderThickness="1" Padding="14,12">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{x:Bind ViewModel.RemovalPlanState, Mode=OneWay}" FontSize="13" LineHeight="18" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{StaticResource RooTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.RemovalPlanDetail, Mode=OneWay}" FontSize="12" LineHeight="17"
                                                   TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}"
                                                   Visibility="{x:Bind ViewModel.RemovalPlanDetail, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
