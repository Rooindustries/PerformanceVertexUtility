<Page
    x:Class="Roo.OptimizationSuite.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Roo.OptimizationSuite.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <DataTemplate x:Key="BaselineTileTemplate" x:DataType="vm:MetricTile">
            <StackPanel Spacing="6" Padding="0,0,18,0">
                <TextBlock Text="{x:Bind Value}" FontSize="22" FontWeight="SemiBold" LineHeight="26" Foreground="{StaticResource RooTextPrimaryBrush}" />
                <TextBlock Text="{x:Bind Label}" FontSize="13" LineHeight="19" Foreground="{StaticResource RooTextSecondaryBrush}" />
                <TextBlock Text="{x:Bind Caption}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource RooPageMargin}">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Reading this PC" Foreground="{StaticResource RooTextMutedBrush}" />
        </StackPanel>

        <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{StaticResource PanelBorderStyle}" Translation="0,0,16"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
            <StackPanel Spacing="8">
                <TextBlock Text="Can't read this PC yet" Style="{StaticResource SectionHeaderTextBlockStyle}" Foreground="{StaticResource RooTextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource RooTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="ReportsScroller" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ReportsContent" Spacing="18" HorizontalAlignment="Center" MaxWidth="1320">

                <Border Style="{StaticResource CommandHeaderBorderStyle}" Translation="0,0,32">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{StaticResource RooAccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Text="Before &amp; After" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource RooTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshBaselineCommand}"
                                    AutomationProperties.Name="Refresh baseline" Padding="12,7" />
                            <Button Content="Game Tune" Click="OpenGameTune_Click"
                                    AutomationProperties.Name="Open Game Tune"
                                    Background="{StaticResource RooNavCtaBrush}" Foreground="{StaticResource RooOnCtaBrush}" Padding="12,7" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="RIGHT NOW (YOUR BASELINE)" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.BaselineStatus, Mode=OneWay}" FontSize="12" LineHeight="17"
                                   TextWrapping="Wrap" Foreground="{StaticResource RooTextMutedBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Baseline}" ItemTemplate="{StaticResource BaselineTileTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="170" MinColumnSpacing="8" MinRowSpacing="16" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Translation="0,0,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="AFTER A TUNE" Style="{StaticResource PanelLabelTextBlockStyle}" Foreground="{StaticResource RooTextMutedBrush}" />
                        <StackPanel Spacing="10" HorizontalAlignment="Center" Padding="0,18">
                            <FontIcon Glyph="&#xE9D9;" FontSize="26" Foreground="{StaticResource RooTextMutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyNote, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"
                                       MaxWidth="520" Foreground="{StaticResource RooTextMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Button Content="Open Game Tune" Click="OpenGameTune_Click"
                                        AutomationProperties.Name="Open Game Tune from reports" Padding="12,7" />
                                <Button Content="Open Cleanup" Click="OpenCleanup_Click"
                                        AutomationProperties.Name="Open Apps and Cleanup from reports" Padding="12,7" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
